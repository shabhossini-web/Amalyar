# Dedicated background worker for database-per-tenant provisioning.
# This image intentionally exposes no HTTP port and runs no public API.
FROM node:22-alpine AS build
RUN apk add --no-cache openssl
WORKDIR /app
RUN npm config set fetch-retries 6 \
 && npm config set fetch-retry-mintimeout 20000 \
 && npm config set fetch-retry-maxtimeout 300000 \
 && npm config set fetch-timeout 600000
COPY package.json package-lock.json ./
# همان کشِ npmِ Dockerfileِ API (id یکسان) — توضیح آن‌جاست.
RUN --mount=type=cache,id=amalyar-npm-server,target=/root/.npm,sharing=locked \
    npm ci --prefer-offline --no-audit --no-fund
COPY . .
RUN npm run build

FROM node:22-alpine
RUN apk add --no-cache openssl
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/src/generated ./dist/generated
COPY --from=build /app/prisma ./prisma
COPY package.json ./

CMD ["node", "dist/scripts/provisioning-worker.js"]
