generator client {
  provider      = "prisma-client-js"
  output        = "../../src/generated/control"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("CONTROL_DATABASE_URL")
}

model Tenant {
  id                   String         @id @default(uuid())
  slug                 String         @unique
  name                 String
  status               String         @default("provisioning")
  databaseUrlEncrypted String         @map("database_url_encrypted")
  databaseKeyVersion   Int            @default(1) @map("database_key_version")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @default(now()) @updatedAt @map("updated_at")
  domains              TenantDomain[]

  @@map("tenants")
}

model TenantDomain {
  id        String   @id @default(uuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  String   @map("tenant_id")
  hostname  String   @unique
  primary   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("tenant_domains")
}

model PlatformOtp {
  id         String    @id @default(uuid())
  phoneHash  String    @map("phone_hash")
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phoneHash, createdAt])
  @@map("platform_otps")
}

model PlatformSession {
  id         String    @id @default(uuid())
  tokenHash  String    @unique @map("token_hash")
  phoneHash  String    @map("phone_hash")
  csrfHash   String    @map("csrf_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([phoneHash, expiresAt])
  @@map("platform_sessions")
}

model ProvisioningJob {
  id              String    @id @default(uuid())
  slug            String    @unique
  name            String
  hostname        String    @unique
  status          String    @default("queued")
  tenantId        String?   @map("tenant_id")
  requestedByHash String    @map("requested_by_hash")
  errorCode       String?   @map("error_code")
  attempts        Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")

  @@index([status, createdAt])
  @@map("provisioning_jobs")
}

/// درخواستِ حذفِ شرکت. API فقط آن را در صف می‌گذارد؛ حذفِ واقعیِ دیتابیس و نقش
/// را Worker انجام می‌دهد — تنها جایی که credentialِ CREATEDB/CREATEROLE دارد.
model TenantDeletionJob {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  slug            String
  name            String
  hostname        String?
  status          String    @default("queued")
  requestedByHash String    @map("requested_by_hash")
  errorCode       String?   @map("error_code")
  attempts        Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")

  @@index([status, createdAt])
  @@index([tenantId])
  @@map("tenant_deletion_jobs")
}

/// ضریبِ ریالیِ سراسریِ تعرفه — سالی یک‌بار، برای **همهٔ** شرکت‌ها یکسان.
///
/// در کنترل است نه در دیتابیسِ هر شرکت، چون حقیقتِ مشترک است: اپراتورِ
/// پلتفرم یک‌بار واردش می‌کند و همهٔ شرکت‌ها همان را می‌خوانند. ضریبِ
/// اختصاصیِ یک شرکت (قراردادِ خاص) همچنان در جدولِ `tariffs`ِ خودش می‌نشیند
/// و بر سراسری مقدم است. مبالغ «تومان» و عددِ صحیح‌اند.
model CentralTariff {
  id     Int    @id @default(autoincrement())
  year   String // سالِ شمسی
  /// private | public | nonprofit | charity | military
  sector String

  professional Int
  technical    Int
  anesthesia   Int

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([year, sector])
  @@map("central_tariffs")
}

/// پیکربندیِ مرکزیِ هوشِ مصنوعی — «مادر». همهٔ شرکت‌ها به‌صورتِ پیش‌فرض
/// اعتبار (base/key) و مدلِ هر قابلیت را از همین می‌خوانند؛ شرکتی که در
/// تنظیماتِ خودش مقدار گذاشته، همان مقدم است. مدل به تفکیکِ قابلیت است
/// (گفتگو/تحلیلِ عکس/گفتار→متن/متن→گفتار/تصویرسازی) چون ارائه‌دهنده‌ها
/// برای هر کار مدلِ جدا می‌دهند. provider فقط پیش‌تنظیمِ UI است
/// (avalai | gapgpt | custom) — حقیقتِ اجرا base_url است.
model CentralAiConfig {
  id       Int    @id @default(1)
  provider String @default("custom")
  baseUrl  String @default("") @map("base_url")
  apiKey   String @default("") @map("api_key")

  modelChat   String @default("") @map("model_chat")
  modelVision String @default("") @map("model_vision")
  modelStt    String @default("") @map("model_stt")
  modelTts    String @default("") @map("model_tts")
  modelImage  String @default("") @map("model_image")

  enabled   Boolean  @default(false)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("central_ai_config")
}

model PlatformAuditEvent {
  id         String   @id @default(uuid())
  actorHash  String?  @map("actor_hash")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  ipHash     String?  @map("ip_hash")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorHash, createdAt])
  @@map("platform_audit_events")
}

/// Public hospital directory; no tenant contacts, patients or private notes belong here.
model CentralHospital {
  id String @id @default(cuid())
  sourceKey String @unique @map("source_key")
  name String
  province String?
  city String?
  address String?
  phone String?
  sector String?
  website String?
  sourceUrl String? @map("source_url")
  sourceName String? @map("source_name")
  checkedAt DateTime? @map("checked_at")
  verified Boolean @default(false)
  active Boolean @default(true)
  searchText String @map("search_text")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  @@index([province, city])
  @@map("central_hospitals")
}
