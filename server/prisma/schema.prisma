// بک‌اندِ عمل‌یار — schema (استاندارد؛ auth + پروفایل + سطوح ۱–۶ + OTP)
generator client {
  provider      = "prisma-client-js"
  // native = محیط توسعه؛ linux-musl-openssl-3.0.x = ایمیج Alpine در سرور
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// هویتِ انسانی — تک‌منبعِ مشخصاتِ هر آدم. نقش‌ها (کاربرِ سامانه، جراح) روی همین
/// یک رکورد سوار می‌شوند، پس کسی که هم کارمند است هم جراح، دو بار وارد نمی‌شود و
/// افزودنِ یک فیلد (مثلاً ایمیل) یک migration است نه سه تا.
///
/// ⚠️ Patient عمداً اینجا نیست: حجمش (ده‌ها هزار رکورد)، چرخهٔ حیاتش (soft-delete)
/// و قواعدِ حریمِ خصوصی‌اش با کارکنان فرق دارد؛ یکی‌کردنشان تعمیمِ بیش‌ازحد است.
model Person {
  id         Int       @id @default(autoincrement())
  firstName  String    @map("first_name")
  lastName   String    @map("last_name")
  nationalId String?   @unique @map("national_id")
  phone      String?   @unique
  email      String?
  birthDate  DateTime? @map("birth_date")
  photo      String?   // dataURL (فعلاً؛ بعداً object-storage)
  address    String?
  city       String?
  iban       String?   // شبا — برای پرداختِ سهم/دستمزد
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  account Account?
  surgeon Surgeon?

  @@index([lastName, firstName])
  @@map("people")
}

/// نقشِ «کاربرِ سامانه» — فقط اعتبارنامه و سطحِ دسترسی. هویت در Person است.
/// سطوح: 1=بازدید 2=کارشناس 3=کارشناس‌ادمین 4=سوپروایزر 5=ادمین 6=سوپرادمین
model Account {
  id           Int       @id @default(autoincrement())
  person       Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId     Int       @unique @map("person_id")
  username     String?   @unique
  passwordHash String    @map("password_hash")
  level        Int       @default(1) // 1..6
  status       String    @default("pending") // pending | active | disabled | rejected
  fee          Int?      // دستمزدِ کارشناس (تومان) — مالیِ سبک؛ قرارداد در حسابداری
  approvedById Int?      @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  sessions    Session[]
  credentials WebauthnCredential[]
  techVisits  Visit[]              @relation("VisitTech")

  @@map("accounts")
}

/// نقشِ «جراح» — هویت در Person است. اگر جراح بخواهد وارد پورتال شود، کافی است
/// روی همان Person یک Account هم ساخته شود؛ هیچ مشخصاتی دوباره وارد نمی‌شود.
/// قرارداد/درصدِ سهم عمداً اینجا نیست و به ماژولِ حسابداری می‌رود.
model Surgeon {
  id        Int      @id @default(autoincrement())
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId  Int      @unique @map("person_id")
  specialty String?  // تخصص
  licenseNo String?  @map("license_no") // شمارهٔ نظامِ پزشکی
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  visits Visit[]

  @@map("surgeons")
}

/// بیمارستان/مرکزِ درمانی — سازمان است نه انسان، پس Person ندارد.
/// ضریبِ تعرفه و مواردِ مالی به ماژولِ حسابداری می‌روند.
model Hospital {
  id           Int      @id @default(autoincrement())
  name         String
  city         String?
  address      String?
  phone        String?
  contactName  String?  @map("contact_name")  // رابطِ هماهنگی
  contactPhone String?  @map("contact_phone")
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  visits Visit[]

  @@map("hospitals")
}

/// نوعِ عمل — موجودیتِ تعریف‌شده، نه متنِ آزاد.
/// دلیل: گزارش‌گیری و تحلیلِ خودکار روی متنِ آزاد ممکن نیست؛ «دیسککتومی» و
/// «دیسکتومی» و «Discectomy» سه چیزِ متفاوت می‌شوند.
model ProcedureType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String?  // کدِ داخلی/ملی
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  visits Visit[]

  @@map("procedure_types")
}

/// تشخیص — همان استدلالِ ProcedureType. icdCode برای نگاشتِ بعدی به ICD-10.
model Diagnosis {
  id        Int      @id @default(autoincrement())
  title     String   @unique
  icdCode   String?  @map("icd_code")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  visits Visit[]

  @@map("diagnoses")
}

/// پس‌کی/اثر انگشت (WebAuthn) — هر کاربر می‌تواند چند دستگاه ثبت کند
model WebauthnCredential {
  id         Int      @id @default(autoincrement())
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId  Int      @map("account_id")
  credId     String   @unique @map("cred_id") // base64url
  publicKey  String   @map("public_key") // base64
  counter    Int      @default(0)
  transports String?
  name       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([accountId])
  @@map("webauthn_credentials")
}

/// سشن‌های چندتایی (حداکثر ۱۰ همزمان) — معادلِ account_sessions
model Session {
  id        String    @id @default(uuid())
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId Int       @map("account_id")
  tokenHash String    @map("token_hash")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([accountId])
  @@map("account_sessions")
}

/// دسترسیِ ماژول‌ها — قابلِ‌تنظیم توسط سوپرادمین (پیش‌فرض‌ها از کد seed می‌شوند).
/// enabled بعداً اهرمِ لایسنس/پلنِ SaaS هم می‌شود.
model Feature {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  minLevel  Int      @default(6) @map("min_level") // حداقل سطحِ لازم (۱..۶)
  enabled   Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("features")
}

/// مجوزهای ریزدانهٔ عملیات؛ Feature فقط روشن/خاموش بودن ماژول است.
model Permission {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  minLevel  Int      @default(6) @map("min_level")
  enabled   Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("permissions")
}

/// ردپای تغییرات حساس؛ این جدول از API عمومی حذف نمی‌شود.
model AuditEvent {
  id         BigInt   @id @default(autoincrement())
  actorId    Int?     @map("actor_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

/// بیمارِ دائمی — یک نفر، چند مراجعه. کدِ خوانا: AM-NNNN
model Patient {
  id         Int      @id @default(autoincrement())
  code       String   @unique // AM-0001
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  phone      String?
  nationalId String?   @map("national_id")
  birthDate  DateTime? @map("birth_date")
  createdAt  DateTime  @default(now()) @map("created_at")
  deletedAt  DateTime? @map("deleted_at")
  deletedById Int?     @map("deleted_by_id")
  deleteReason String? @map("delete_reason")

  visits Visit[]

  @@index([phone])
  @@map("patients")
}

/// مراجعه (Visit) — واحدِ اصلیِ کار: عمل/خدمت برای یک بیمار
/// ⚠️ همهٔ مبالغ «تومان» و عددِ صحیح‌اند (قانونِ تک‌واحدی — درسِ ملک‌طب)
model Visit {
  id           Int       @id @default(autoincrement())
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId    Int       @map("patient_id")
  seq          Int       @default(1) // شمارهٔ مراجعهٔ بیمار → کدِ AM-0001-V2
  // عکسِ لحظهٔ ثبت — فقط وقتی خوانده می‌شود که رابطه از بین رفته باشد (جراح/بیمارستانِ
  // حذف‌شده). عمداً با تغییرِ نامِ موجودیت به‌روز نمی‌شود؛ عکسی که بازنویسی شود عکس نیست.
  surgeonName  String?   @map("surgeon_name")
  hospitalName String?   @map("hospital_name")
  opType       String?   @map("op_type") // عکسِ لحظه‌ای از نامِ نوعِ عمل
  surgeon      Surgeon?  @relation(fields: [surgeonId], references: [id], onDelete: SetNull)
  surgeonId    Int?      @map("surgeon_id")
  hospital     Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  hospitalId   Int?      @map("hospital_id")
  tech         Account?  @relation("VisitTech", fields: [techId], references: [id], onDelete: SetNull)
  techId       Int?      @map("tech_id") // کارشناسِ منتسب (از accounts)

  procedureType   ProcedureType? @relation(fields: [procedureTypeId], references: [id], onDelete: SetNull)
  procedureTypeId Int?           @map("procedure_type_id")
  diagnosis       Diagnosis?     @relation(fields: [diagnosisId], references: [id], onDelete: SetNull)
  diagnosisId     Int?           @map("diagnosis_id")
  /// شرحِ عمل — متنِ جراح. برخلافِ تشخیص و نوعِ عمل، اینجا متنِ آزاد درست است:
  /// روایتِ بالینی است، نه چیزی که رویش گروه‌بندی/گزارش‌گیری شود.
  opReport        String?        @map("op_report")

  opDate       DateTime? @map("op_date") // تاریخِ عمل
  opStatus     String    @default("pending") @map("op_status") // pending | done | cancelled
  amount       Int       @default(0) // تومان
  paid         Int       @default(0) // تومان
  notes        String?
  createdById  Int?      @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([patientId, seq])
  @@index([patientId])
  @@index([opStatus])
  @@index([opDate])
  @@index([surgeonId]) // پورتالِ جراح: «مراجعه‌های من»
  @@index([procedureTypeId])
  @@index([diagnosisId])
  @@map("visits")
}

/// کدهای یکبارمصرفِ ثبت‌نام/تأیید موبایل
model OtpCode {
  id         Int       @id @default(autoincrement())
  phone      String
  codeHash   String    @map("code_hash")
  purpose    String    @default("signup") // signup | ...
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone])
  @@map("otp_codes")
}
