// بک‌اندِ عمل‌یار — schema (استاندارد؛ auth + پروفایل + سطوح ۱–۶ + OTP)
generator client {
  provider      = "prisma-client-js"
  // native = محیط توسعه؛ linux-musl-openssl-3.0.x = ایمیج Alpine در سرور
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// همهٔ کاربران — پروفایلِ استاندارد + سطحِ دسترسیِ ۱..۶
/// سطوح: 1=بازدید 2=کارشناس 3=کارشناس‌ادمین 4=سوپروایزر 5=ادمین 6=سوپرادمین
model Account {
  id           Int       @id @default(autoincrement())
  firstName    String?   @map("first_name")
  lastName     String?   @map("last_name")
  username     String?   @unique
  phone        String?   @unique
  passwordHash String    @map("password_hash")
  selfie       String?   // dataURL سلفی (فعلاً؛ بعداً object-storage)
  level        Int       @default(1) // 1..6
  status       String    @default("pending") // pending | active | disabled | rejected
  approvedById Int?      @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  sessions Session[]

  @@map("accounts")
}

/// سشن‌های چندتایی (حداکثر ۱۰ همزمان) — معادلِ account_sessions
model Session {
  id        String    @id @default(uuid())
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId Int       @map("account_id")
  tokenHash String    @map("token_hash")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([accountId])
  @@map("account_sessions")
}

/// کدهای یکبارمصرفِ ثبت‌نام/تأیید موبایل
model OtpCode {
  id         Int       @id @default(autoincrement())
  phone      String
  codeHash   String    @map("code_hash")
  purpose    String    @default("signup") // signup | ...
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone])
  @@map("otp_codes")
}
