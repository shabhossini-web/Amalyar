// بک‌اندِ عمل‌یار — schema (استاندارد؛ auth + پروفایل + سطوح ۱–۶ + OTP)
generator client {
  provider      = "prisma-client-js"
  // native = محیط توسعه؛ linux-musl-openssl-3.0.x = ایمیج Alpine در سرور
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// هویتِ انسانی — تک‌منبعِ مشخصاتِ هر آدم. نقش‌ها (کاربرِ سامانه، جراح) روی همین
/// یک رکورد سوار می‌شوند، پس کسی که هم کارمند است هم جراح، دو بار وارد نمی‌شود و
/// افزودنِ یک فیلد (مثلاً ایمیل) یک migration است نه سه تا.
///
/// ⚠️ Patient عمداً اینجا نیست: حجمش (ده‌ها هزار رکورد)، چرخهٔ حیاتش (soft-delete)
/// و قواعدِ حریمِ خصوصی‌اش با کارکنان فرق دارد؛ یکی‌کردنشان تعمیمِ بیش‌ازحد است.
model Person {
  id         Int       @id @default(autoincrement())
  firstName  String    @map("first_name")
  lastName   String    @map("last_name")
  nationalId String?   @unique @map("national_id")
  phone      String?   @unique
  email      String?
  birthDate  DateTime? @map("birth_date")
  photo      String? // dataURL (فعلاً؛ بعداً object-storage)
  address    String?
  city       String?
  iban       String? // شبا — برای پرداختِ سهم/دستمزد
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")

  account   Account?
  surgeon   Surgeon?
  transport TransportStaff?

  @@index([lastName, firstName])
  @@map("people")
}

/// نقشِ «کاربرِ سامانه» — فقط اعتبارنامه و سطحِ دسترسی. هویت در Person است.
/// سطوح: 1=بازدید 2=کارشناس 3=کارشناس‌ادمین 4=سوپروایزر 5=ادمین 6=سوپرادمین
model Account {
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  verificationDueAt DateTime? @map("verification_due_at")
  systemKey String? @unique @map("system_key")
  hospitalDuties HospitalDuty[]
  id           Int       @id @default(autoincrement())
  person       Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId     Int       @unique @map("person_id")
  username     String?   @unique
  passwordHash String    @map("password_hash")
  level        Int       @default(1) // 1..6
  status       String    @default("pending") // pending | active | disabled | rejected
  fee          Int? // دستمزدِ کارشناس (تومان) — مالیِ سبک؛ قرارداد در حسابداری
  approvedById Int?      @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  sessions    Session[]
  credentials WebauthnCredential[]
  techVisits  Visit[]              @relation("VisitTech")
  chatMemberships ChatMember[]

  /// نقشِ شغلی — doctor | secretary | nurse | assistant. جدا از `level`:
  /// سطح می‌گوید «چقدر می‌بینی»، نقش می‌گوید «کدام بخشِ فرم مالِ توست».
  /// `null` = بی‌نقش؛ هیچ محدودیتی ندارد (همهٔ حساب‌های موجود همین‌اند).
  jobRole String? @map("job_role")

  /// نوبت‌دهی (`docs/BOOKING.md`) — برنامهٔ کاری، استثنا و نوبت‌های این پزشک.
  availabilityRules      AvailabilityRule[]      @relation("AvailabilityDoctor")
  availabilityExceptions AvailabilityException[] @relation("AvailabilityExceptionDoctor")
  appointments           Appointment[]           @relation("AppointmentDoctor")

  @@index([verificationDueAt])
  @@map("accounts")
}

/// نقشِ «جراح» — هویت در Person است. اگر جراح بخواهد وارد پورتال شود، کافی است
/// روی همان Person یک Account هم ساخته شود؛ هیچ مشخصاتی دوباره وارد نمی‌شود.
/// قرارداد/درصدِ سهم عمداً اینجا نیست و به ماژولِ حسابداری می‌رود.
model Surgeon {
  id        Int      @id @default(autoincrement())
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId  Int      @unique @map("person_id")
  specialty String? // تخصص
  licenseNo String?  @map("license_no") // شمارهٔ نظامِ پزشکی
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  visits    Visit[]
  contracts SurgeonContract[]

  @@map("surgeons")
}

/// بیمارستان/مرکزِ درمانی — سازمان است نه انسان، پس Person ندارد.
/// ضریبِ تعرفه و مواردِ مالی به ماژولِ حسابداری می‌روند.
/// الگوی اقلامِ یک نوعِ عمل.
///
/// ⚠️ «نیاز» است نه «تعهد»: می‌گوید نورومانیتورینگ دستگاه می‌خواهد و
/// پیچ‌گذاری ست و مصرفی — ولی خودش هیچ لاتی را رزرو نمی‌کند. چینش از روی
/// همین الگو بار را **پیشنهاد** می‌دهد و کسری را نشان می‌دهد؛ تصمیم با
/// چینش‌کننده است. اگر این جدول رزرو می‌کرد، هر تغییرِ الگو تعهدهای دیروزِ
/// ثبت‌شده را هم عوض می‌کرد.
model ProcedureTypeItem {
  id              Int           @id @default(autoincrement())
  procedureType   ProcedureType @relation(fields: [procedureTypeId], references: [id], onDelete: Cascade)
  procedureTypeId Int           @map("procedure_type_id")
  item            Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId          Int           @map("item_id")
  /// تعدادِ معمول — برای مصرفی معنا دارد، برای دستگاه معمولاً ۱.
  quantity        Int           @default(1)
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([procedureTypeId, itemId])
  @@map("procedure_type_items")
}

model Hospital {
  duties HospitalDuty[]
  sector String @default("private")
  id           Int      @id @default(autoincrement())
  name         String
  city         String?
  address      String?
  phone        String?
  contactName  String?  @map("contact_name") // رابطِ هماهنگی
  contactPhone String?  @map("contact_phone")
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  visits    Visit[]
  payerFor  Visit[]         @relation("VisitPayer")
  transfers StockTransfer[]
  needs     HospitalItem[]
  stops     TransportStop[]
  aliases   HospitalAlias[]
  consigned StockLot[]
  counts    ConsignmentCount[]

  @@map("hospitals")
}

/// نامِ مستعارِ یک بیمارستان — «لقمان»، «بیمارستان لقمان»، «لقمان حکیم».
///
/// ⚠️ این جدول **حافظهٔ تصمیمِ آدم** است، نه حدسِ ماشین. تطبیقِ خودکار فقط
/// پیشنهاد می‌دهد؛ وقتی کاربر تأیید کرد، اینجا ثبت می‌شود تا دیگر نپرسد.
/// ادغامِ خودکار دو بیمارستانِ واقعاً متفاوت را برای همیشه یکی می‌کند و
/// گزارشِ مالی را بی‌سروصدا خراب.
model HospitalAlias {
  id         Int      @id @default(autoincrement())
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  hospitalId Int      @map("hospital_id")
  /// نامی که کاربر واقعاً نوشته بود — برای اینکه معلوم باشد از کجا آمده.
  alias      String
  /// شکلِ کانونی (`normalizeName`) — کلیدِ تطبیق. یکتاست تا یک نام به دو
  /// بیمارستان نگاشت نشود.
  aliasNorm  String   @unique @map("alias_norm")
  createdById Int?    @map("created_by_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([hospitalId])
  @@map("hospital_aliases")
}

/// نیازِ استانداردِ یک بیمارستان — «لقمان همیشه دستگاهِ C2 و ستِ پدیکولار می‌خواهد».
///
/// چینش بدونِ این باید هر بار از حافظهٔ آدم‌ها دربیاورد که کجا چه می‌خواهد؛ با
/// این، پیشنهادِ پیش‌فرضِ حواله از خودِ بیمارستان می‌آید. **الزام نیست، پیشنهاد
/// است**: عملِ خاص می‌تواند چیزِ دیگری بخواهد.
model HospitalItem {
  id         Int      @id @default(autoincrement())
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  hospitalId Int      @map("hospital_id")
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId     Int      @map("item_id")
  quantity   Int      @default(1)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([hospitalId, itemId])
  @@index([itemId])
  @@map("hospital_items")
}

/// کتابِ ارزش نسبیِ خدماتِ سلامت — کدِ ملیِ خدمت.
///
/// مرجعِ ملی است و برای همهٔ شرکت‌ها یکی، ولی عمداً در دیتابیسِ خودِ شرکت
/// می‌نشیند: ۶۰۰۰ ردیف چیزی نیست، مرزِ جداییِ شرکت‌ها دست‌نخورده می‌ماند، و هر
/// شرکت می‌تواند کدِ محلیِ خودش را اضافه کند یا نسخهٔ سالِ قبل را نگه دارد
/// (پروندهٔ قدیمی باید با تعرفهٔ همان سال صورت‌حساب شود).
///
/// ⚠️ ارزش‌ها «هزارم‌واحد»اند و عددِ صحیح: در کلِ کتاب بیشترین دقت سه رقمِ اعشار
/// است، پس ×۱۰۰۰ دقیقاً صحیح می‌شود و جمعِ صدها ردیفِ فاکتور خطای شناور نمی‌گیرد.
model ServiceCode {
  code     String  @id // کدِ ملیِ ۶ رقمی
  title    String
  notes    String?
  /// ویژگی: + (کدِ افزوده) * # و ترکیب‌هایشان
  modifier String?

  rvuTotal        Int?    @map("rvu_total")
  rvuProfessional Int?    @map("rvu_professional")
  rvuTechnical    Int?    @map("rvu_technical")
  rvuAnesthesia   Int?    @map("rvu_anesthesia")
  /// ارزشِ بیهوشی مقطوع است («ارزش تام N واحد») نه محاسبه‌شده.
  anesthesiaFlat  Boolean @default(false) @map("anesthesia_flat")

  /// نسخهٔ کتاب (سالِ شمسی) — تا معلوم باشد این ردیف از کدام ویرایش آمده.
  version String
  active  Boolean @default(true)

  procedureTypes ProcedureType[]

  @@index([title])
  @@map("service_codes")
}

/// ضریبِ ریالیِ هر واحدِ ارزشِ نسبی.
///
/// جدا از ServiceCode است چون سالانه و بر اساسِ بخش (خصوصی/دولتی/…) عوض می‌شود
/// در حالی که خودِ ارزشِ نسبی ثابت می‌ماند. مبالغ «تومان» و عددِ صحیح‌اند.
model Tariff {
  id     Int    @id @default(autoincrement())
  year   String // سالِ شمسی
  /// private | public | nonprofit | charity
  sector String

  professional Int // تومان به‌ازای هر واحدِ جزء حرفه‌ای
  technical    Int
  anesthesia   Int

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([year, sector])
  @@map("tariffs")
}

/// نوعِ عمل — موجودیتِ تعریف‌شده، نه متنِ آزاد.
/// دلیل: گزارش‌گیری و تحلیلِ خودکار روی متنِ آزاد ممکن نیست؛ «دیسککتومی» و
/// «دیسکتومی» و «Discectomy» سه چیزِ متفاوت می‌شوند.
model ProcedureType {
  noteTemplates NoteTemplate[]
  id    Int     @id @default(autoincrement())
  name  String  @unique
  code  String? // کدِ داخلی/ملی
  notes String?

  /// اتصال به کتابِ ارزش نسبی — اختیاری، چون بعضی خدمات کدِ ملی ندارند.
  /// با این اتصال، صورت‌حساب می‌تواند فی را از ارزشِ نسبی × ضریب حساب کند.
  serviceCode    ServiceCode? @relation(fields: [serviceCodeRef], references: [code], onDelete: SetNull)
  serviceCodeRef String?      @map("service_code_ref")

  /// قالبِ پیامِ مراقبت — به تفکیکِ نوعِ عمل، ویراستنی توسطِ خودِ مطب
  /// (نه متنِ سختِ کد): قبل از عمل (ناشتایی، قطعِ دارو…) و بعد از عمل.
  /// خالی = برای این نوعِ عمل پیامِ مراقبتی نمی‌رود.
  preOpCare  String? @map("pre_op_care")
  postOpCare String? @map("post_op_care")
  /// روزهای پیگیریِ پس از عمل — «۷,۳۰,۹۰» (روزِ بعد از opDate). خالی = پیگیریِ
  /// خودکاری برای این نوعِ عمل نمی‌رود. متن است نه جدول، چون فقط زمان‌بندی است
  /// و ویرایشش باید به سادگیِ همان قالبِ مراقبت باشد.
  followUpDays String? @map("follow_up_days")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")

  visits Visit[]
  /// الگوی اقلام — «این نوعِ عمل معمولاً چه چیزی می‌خواهد».
  needs  ProcedureTypeItem[]
  /// فرم‌های پیگیریِ اختصاصیِ همین نوعِ عمل (FormDef.followUp = procedure).
  followUpForms FormDef[]

  @@map("procedure_types")
}

/// **موضوعِ ویزیت** — ویزیتِ اولیه، پست‌آپ، زیبایی، …
///
/// ⚠️ عمداً جدا از `Visit.kind`. `kind` تعیین می‌کند **کدام فرم** رندر شود
/// (فرمِ ویزیت در برابر فرمِ جراحی)؛ موضوع یک دسته‌بندی **داخلِ** همان فرم
/// است. ویزیتِ اولیه و پست‌آپ هر دو همان فرمِ ویزیت را می‌گیرند ولی روزِ
/// کاریِ متفاوتی دارند و گزارشِ متفاوتی می‌سازند. اگر یکی می‌شدند، برای هر
/// موضوع باید یک فرمِ کامل ساخته می‌شد و هر تغییرِ فرم چندبار تکرار می‌شد.
///
/// موضوع در مرحلهٔ بعد به برنامهٔ کاری وصل می‌شود («شنبه‌ها ویزیتِ اولیه») تا
/// بیمار در هر روز فقط موضوعِ همان روز را ببیند. طراحی: `docs/BOOKING.md`.
model VisitTopic {
  noteTemplates NoteTemplate[]
  id   Int    @id @default(autoincrement())
  name String @unique
  /// توکنِ رنگ (نه هگز) — همان قرارِ `FormDef.color`، تا با تمِ برند بخواند.
  color String?
  notes String?

  active Boolean @default(true)
  /// ترتیبِ نمایش؛ عدد تا جابه‌جایی با یک UPDATE انجام شود.
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  visits Visit[]

  /// روزهای کاری‌ای که این موضوع رویشان مجاز است، و نوبت‌هایی که گرفته‌اند.
  ruleTopics   AvailabilityRuleTopic[]
  appointments Appointment[]

  @@map("visit_topics")
}

/// کالا — ست، پیچ، ایمپلنت و هر قلمِ مصرفی که در عمل استفاده می‌شود.
///
/// برای شرکتِ تجهیزات همان نقشی را دارد که ProcedureType برای شرکتِ خدمات:
/// موجودیتِ تعریف‌شده به‌جای متنِ آزاد، تا فاکتور و گزارشِ مصرف معنا داشته باشد.
///
/// ⚠️ این کاتالوگ است نه انبار. «چند تا داریم» و «کدام لات کجا رفت» در
/// StockLot/StockMovement است؛ ریختنشان اینجا یعنی یک ردیفِ کاتالوگ همزمان
/// تعریف و موجودی باشد که با اولین انتقالِ انبار می‌شکند.
model Item {
  id       Int     @id @default(autoincrement())
  name     String
  /// کدِ کالای شرکت (SKU) — یکتا اگر باشد.
  sku      String? @unique
  /// کدِ IRC / اصالت‌سنجیِ وزارت بهداشت.
  irc      String?
  brand    String?
  /// اندازه/مشخصهٔ فنی: «۵٫۵×۴۵ میلی‌متر»
  size     String?
  category String? // پیچ، راد، کیج، مصرفی…
  unit     String  @default("عدد")
  /// consumable | set | device
  ///
  /// ⚠️ تفاوتِ بنیادی: مصرفی یک‌بار می‌رود و تمام؛ ست و دستگاه **برمی‌گردند** و
  /// فردا دوباره می‌روند. برای مصرفی سؤال «چند تا داریم» است، برای برگشتی
  /// «فردا آزاد است؟» — و جوابِ دومی از موجودی درنمی‌آید، از تقویمِ تعهدها.
  assetKind String  @default("consumable") @map("asset_kind")
  /// ساعتِ آماده‌سازی پس از برگشت (استریل در CSR، شارژ، کالیبراسیونِ سریع).
  /// بدونِ این، تقویم داراییِ تازه‌برگشته را همان لحظه آزاد نشان می‌دهد و
  /// چینش ستی را می‌فرستد که هنوز استریل نشده.
  turnaroundHours Int? @map("turnaround_hours")
  /// قیمتِ پایه (تومان). فاکتور مبلغِ خودش را کپی می‌کند، پس تغییرِ بعدیِ
  /// این عدد فاکتورهای صادرشده را دست نمی‌زند.
  price    Int?
  notes    String?
  active   Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  charges       Charge[]
  lots          StockLot[]
  hospitalNeeds HospitalItem[]
  contents      ItemComponent[] @relation("SetContents")
  partOf        ItemComponent[] @relation("PartOfSets")

  @@index([name])
  @@index([category])
  @@map("items")
  /// در الگوی کدام نوع‌عمل‌ها آمده است.
  procedureNeeds ProcedureTypeItem[]
}

/// یک لاتِ فیزیکی از یک کالا — «کدام بچ، چند تا، کجا، تا کِی».
///
/// ⚠️ تفاوتش با Item بنیادی است و نباید محو شود: Item می‌گوید «پیچ پدیکولار ۵٫۵»
/// (تعریف)، StockLot می‌گوید «این ۱۲ عددِ لاتِ A-4471 که تا مهرِ ۱۴۰۶ اعتبار
/// دارد و در ستِ شمارهٔ ۲ است» (شیءِ واقعی). فراخوانِ سازنده روی لات است، نه
/// روی تعریف — و همین دلیلِ وجودِ این جدول است.
///
/// serialNo برای ایمپلنتی است که تک‌تک ردیابی می‌شود؛ چنین لاتی حداکثر یک عدد
/// دارد. این قاعده در سرویس اعمال می‌شود، چون DB نمی‌تواند جمعِ دفتر را ببیند.
model StockLot {
  id        Int       @id @default(autoincrement())
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  itemId    Int       @map("item_id")
  /// شمارهٔ لات/بچِ سازنده — کلیدِ فراخوان.
  lotNo     String?   @map("lot_no")
  /// شمارهٔ سریالِ یکتا (اگر کالا سریالی باشد).
  serialNo  String?   @unique @map("serial_no")
  expiresAt DateTime? @map("expires_at")
  /// کالیبراسیون/سرویسِ بعدیِ دستگاه. دستگاهِ از کالیبراسیون‌افتاده سرِ عمل
  /// مسئولیتِ حقوقی است، پس تقویم آن را «آمادهٔ اعزام» نشان نمی‌دهد.
  nextServiceAt DateTime? @map("next_service_at")
  /// **محلِ خانهٔ** لات — انبارِ خودمان که این لات از آن‌جا می‌رود و به آن‌جا
  /// برمی‌گردد. محلِ *فعلیِ* هر تعداد، از دفتر مشتق می‌شود (`StockMovement.location`)،
  /// چون یک لات می‌تواند همزمان چند جا باشد. «در دسترس» = موجودی در همین محل.
  location  String?
  /// **امانیِ مستقر** — این لات در بیمارستان زندگی می‌کند، نه در انبار. اگر پر
  /// باشد، «بیرون بودن» وضعیتِ عادیِ اوست نه بدهیِ برگشت: تقویم آن را «امانی»
  /// نشان می‌دهد و صفِ جمع‌آوری سراغش نمی‌رود. بدونِ این، دستگاهِ امانی برای
  /// همیشه «بیرون» می‌ماند و هر روز در فهرستِ کارِ نکرده تکرار می‌شود.
  consignedTo   Hospital? @relation(fields: [consignedToId], references: [id], onDelete: SetNull)
  consignedToId Int?      @map("consigned_to_id")
  consignedAt   DateTime? @map("consigned_at")
  /// دورهٔ صورت‌برداری به روز. امانی بدونِ شمارشِ دوره‌ای یعنی موجودیِ کاغذی:
  /// مصرف‌شده‌ها فاکتور نمی‌شوند و کسری سال‌ها بعد پیدا می‌شود.
  countEveryDays Int?     @map("count_every_days")
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")

  movements StockMovement[]
  shortages SetShortage[]
  counts    ConsignmentCount[]

  @@index([itemId])
  @@index([lotNo])
  @@index([expiresAt])
  @@map("stock_lots")
}

/// دفترِ حرکتِ انبار — تنها منبعِ حقیقتِ موجودی.
///
/// موجودی ستون نیست، جمعِ همین ردیف‌هاست (`balanceOf`). عمداً: عددِ ذخیره‌شده
/// در کنارِ دفتر دیر یا زود از دفتر جدا می‌افتد و آن‌وقت معلوم نیست کدام درست
/// است. همان قاعدهٔ `summarize` در مالی — یک فرمول، یک جا.
///
/// دفتر فقط اضافه می‌شود: اشتباه با حرکتِ جبرانی اصلاح می‌شود، نه با حذف.
model StockMovement {
  id    Int      @id @default(autoincrement())
  lot   StockLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  lotId Int      @map("lot_id")

  /// in | out | return | adjust
  kind     String
  /// علامت‌دار: ورود مثبت، مصرف منفی. علامت را سرویس می‌گذارد نه کاربر — وگرنه
  /// یک‌بار کسی یادش می‌رود منفی بزند و موجودی برای همیشه غلط می‌ماند.
  quantity Int

  visit     Visit?  @relation(fields: [visitId], references: [id], onDelete: SetNull)
  visitId   Int?    @map("visit_id")
  /// عکسِ کدِ مراجعه. رابطه ممکن است از بین برود؛ پاسخِ «این لات در کدام عمل‌ها
  /// مصرف شد» نباید با آن از بین برود.
  visitCode String? @map("visit_code")
  /// قلمِ فاکتورِ مرتبط — عمداً بدون رابطه: حذفِ قلمِ فاکتور نباید سابقهٔ مصرفِ
  /// یک ایمپلنتِ کارگذاشته‌شده را پاک کند.
  chargeId  Int?    @map("charge_id")

  reason    String?
  /// شمارهٔ رسیدِ خرید، حواله، یا هر ارجاعِ بیرونی.
  reference String?

  /// **محلِ وقوعِ حرکت.** موجودیِ هر محل از جمعِ همین ستون مشتق می‌شود، دقیقاً
  /// مثلِ خودِ موجودی که جمعِ `quantity` است.
  ///
  /// چرا ستونِ `StockLot.location` کافی نبود: یک لاتِ ۲۰تایی می‌تواند ۱۲ عددش
  /// در ستِ بیمارستانِ الف باشد و ۸ عددش در انبار. «محلِ لات» برای چنین چیزی
  /// سؤالِ غلطی است؛ سؤالِ درست «چند تا کجاست» است و جوابش فقط از دفتر می‌آید.
  location String?

  /// حوالهٔ ارسال — دو پایهٔ یک انتقال (خروج از مبدأ، ورود به مقصد) را به هم می‌بندد.
  transfer   StockTransfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)
  transferId Int?           @map("transfer_id")

  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([lotId])
  @@index([visitId])
  @@index([chargeId])
  @@index([transferId])
  @@index([lotId, location])
  @@map("stock_movements")
}

/// حوالهٔ ارسال — سندِ سفرِ کالا از انبارِ ما به یک مقصد و برگشتش.
///
/// چرخهٔ واقعیِ شرکتِ ایمپلنت: ست به بیمارستان می‌رود → CSR استریل می‌کند →
/// سرِ عمل بخشی مصرف می‌شود → بقیه برمی‌گردد. بدونِ این سند، «چند تا رفت و
/// چند تا برگشت» قابلِ اثبات نیست و دعوای «یکی کم است» با بیمارستان راهِ حل
/// ندارد. رسیدِ تحویلِ CSR (`receivedBy`) دقیقاً همین را حل می‌کند.
///
/// خودِ سند موجودی را جابه‌جا نمی‌کند؛ حرکت‌های `transfer` این کار را می‌کنند.
/// سند فقط آن‌ها را به هم می‌بندد و امضا/تاریخ را نگه می‌دارد.
model StockTransfer {
  id           Int    @id @default(autoincrement())
  /// HV-NNNN — شمارهٔ حواله روی برگهٔ چاپی.
  code         String @unique
  fromLocation String @map("from_location")
  toLocation   String @map("to_location")

  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  hospitalId Int?      @map("hospital_id")
  /// عملی که این ست برایش رفته — مبنای «این ست فردا آزاد است؟»
  visit      Visit?    @relation(fields: [visitId], references: [id], onDelete: SetNull)
  visitId    Int?      @map("visit_id")
  /// توقفی که این حواله را می‌برد یا برمی‌گرداند — «چه کسی این را حمل می‌کند»
  /// از همین‌جا مشتق می‌شود، نه از تخصیصِ جدا.
  stop       TransportStop? @relation(fields: [stopId], references: [id], onDelete: SetNull)
  stopId     Int?      @map("stop_id")

  /// planned | sent | received | closed
  status     String    @default("sent")
  /// قلم‌های حوالهٔ **برنامه‌ریزی‌شده** — تا وقتی بار نرفته، دفترِ انبار نباید
  /// بخورد؛ پس قلم‌ها این‌جا می‌مانند و موقعِ `ship` به حرکت تبدیل می‌شوند.
  /// [{ lotId, quantity }]
  plannedLines Json?    @map("planned_lines")
  /// روزی که این حواله برای آن است. جدا از `sentAt` است: حوالهٔ فردا را امروز
  /// صادر می‌کنیم.
  plannedFor DateTime? @map("planned_for")

  /// **بازهٔ تعهدِ دارایی** — از کِی تا کِی این ست/دستگاه گرفتار است.
  ///
  /// ⚠️ اول تعارض «همان دارایی، همان روز» تعریف شده بود و **غلط بود**: یک
  /// دستگاه در یک روز بینِ دو بیمارستان می‌چرخد — صبح لقمان، بعدازظهر میلاد.
  /// تعارضِ واقعی هم‌پوشانیِ **بازه** است، نه اشتراکِ روز.
  windowFrom DateTime? @map("window_from")
  /// خالی = هنوز آزاد نشده. آزادسازی با اعلامِ پایانیِ کارشناس انجام می‌شود،
  /// نه با ساعتِ حدسیِ دفتر.
  windowTo   DateTime? @map("window_to")

  /// اعلامِ پایانیِ کارشناسِ سرِ عمل: «عمل تمام شد، ست آمادهٔ جمع‌آوری است».
  /// همین رویداد هم دارایی را آزاد می‌کند هم صفِ جمع‌آوریِ راننده را می‌سازد.
  releasedAt   DateTime? @map("released_at")
  releasedById Int?      @map("released_by_id")
  releaseNote  String?   @map("release_note")
  /// «ساعت ۵ بیا ببر» — ساعتِ درخواستیِ کارشناس برای جمع‌آوری، «HH:MM».
  pickupAt     String?   @map("pickup_at")
  /// «گذاشتم CSR» — کجا تحویل داده شده تا جمع‌آور بداند سراغِ کجا برود.
  leftAt       String?   @map("left_at")
  sentAt     DateTime  @default(now()) @map("sent_at")
  receivedAt DateTime? @map("received_at")
  /// نامِ تحویل‌گیرندهٔ CSR.
  receivedBy String?   @map("received_by")
  notes      String?

  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  movements StockMovement[]
  shortages SetShortage[]

  @@index([status])
  @@index([visitId])
  @@index([hospitalId])
  @@map("stock_transfers")
}

/// تشخیص — همان استدلالِ ProcedureType. icdCode برای نگاشتِ بعدی به ICD-10.
model Diagnosis {
  noteTemplates NoteTemplate[]
  id        Int      @id @default(autoincrement())
  title     String   @unique
  icdCode   String?  @map("icd_code")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  visits Visit[]
  /// فرم‌های پیگیریِ اختصاصیِ همین تشخیص (FormDef.followUp = diagnosis).
  followUpForms FormDef[]

  @@map("diagnoses")
}

/// جراحی/خدمتِ داخلِ مطب — کدِ **داخلیِ** خودِ مطب با مبلغِ مصوبش.
///
/// جدا از کتابِ ارزش نسبی است: آن کتاب ملی و مرکزی است، این را هر مطب برای
/// کارهای خودش (تزریق، بخیه، عملِ سرپایی…) تعریف می‌کند. فاکتورِ «با کد» هر
/// دو نظامِ کد را می‌پذیرد و روی قلم، منبعِ کد (`Charge.codeSystem`) می‌ماند.
model InternalCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique // کدِ دلخواهِ مطب — MT-01، INJ3، …
  name      String
  price     Int // تومان
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("internal_codes")
}

/// نامهٔ اداری — سندِ رسمیِ چاپ‌شونده روی سربرگِ شرکت.
///
/// شماره («سالِ شمسی/شماره») هنگامِ ساخت تخصیص می‌یابد و **هرگز عوض نمی‌شود** —
/// نامه‌ای که شماره‌اش بعد از صدور عوض شود سندِ اداری نیست. حذف مجاز است
/// (سطحِ ۵ به بالا) و در audit ثبت می‌شود؛ شمارهٔ حذف‌شده دوباره استفاده
/// نمی‌شود مگر آخرینِ سال باشد — سوراخِ شماره بهتر از شمارهٔ دوبار‌مصرف است.
model Letter {
  id Int @id @default(autoincrement())

  /// شمارهٔ رسمی — «1405/12»؛ یکتا، شمارنده هر سال از یک.
  no String @unique

  recipient String
  subject   String
  body      String

  /// متنِ کوتاهِ «پیوست:» — خالی یعنی «ندارد».
  attachment String?

  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("letters")
}

/// قالبِ شرحِ بالینی (HIS-گونه) — متنِ آماده برای شرحِ حال/ویزیت/عمل و… .
///
/// هدف‌گیری اختیاری است: قالبِ بی‌هدف «عمومی» است و برای هر بیماری پیشنهاد
/// می‌شود؛ قالبِ گره‌خورده به نوعِ عمل/تشخیص/موضوع فقط وقتی می‌آید که
/// مراجعهٔ انتخاب‌شده همان را داشته باشد — و در پیشنهادها **جلوتر** از
/// عمومی‌ها می‌نشیند (اختصاصی‌تر = مربوط‌تر). `SetNull` چون حذفِ تعریف نباید
/// قالب را ببرد؛ قالب عمومی می‌شود، نه ناپدید.
model NoteTemplate {
  id    Int    @id @default(autoincrement())
  /// همان واژگانِ ClinicalNote.kind: history | visit | op | progress | discharge | consult
  kind  String
  title String
  body  String

  procedureType   ProcedureType? @relation(fields: [procedureTypeId], references: [id], onDelete: SetNull)
  procedureTypeId Int?           @map("procedure_type_id")
  diagnosis       Diagnosis?     @relation(fields: [diagnosisId], references: [id], onDelete: SetNull)
  diagnosisId     Int?           @map("diagnosis_id")
  topic           VisitTopic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  topicId         Int?           @map("topic_id")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([kind, active])
  @@map("note_templates")
}

/// کانالِ چتِ سازمانی — dm (دونفره) یا group (گروه).
///
/// dm با کلیدِ «dm:کوچک‌تر:بزرگ‌تر» یکتا می‌شود: دو نفر همیشه **یک** گفتگو
/// دارند و «گفتگوی تازه» با نفرِ تکراری همان قبلی را باز می‌کند — قفلِ
/// همزمانی هم همان قیدِ یکتاست، نه «اول بخوان بعد بساز».
model ChatChannel {
  id          Int      @id @default(autoincrement())
  kind        String   @default("dm")
  name        String?
  dmKey       String?  @unique @map("dm_key")
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  members  ChatMember[]
  messages ChatMessage[]

  @@map("chat_channels")
}

model ChatMember {
  id        Int         @id @default(autoincrement())
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId Int         @map("channel_id")
  account   Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId Int         @map("account_id")

  /// آخرین پیامِ خوانده — «نخوانده» مشتقِ همین است، نه ستونِ شمارنده که از
  /// واقعیت عقب بماند.
  lastReadId Int      @default(0) @map("last_read_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([channelId, accountId])
  @@index([accountId])
  @@map("chat_members")
}

model ChatMessage {
  id        Int         @id @default(autoincrement())
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  channelId Int         @map("channel_id")

  authorId   Int    @map("author_id")
  /// عکسِ لحظهٔ نگارش — نویسنده باید معلوم بماند حتی اگر حسابش حذف شود.
  authorName String @map("author_name")
  body       String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([channelId, id])
  @@map("chat_messages")
}

/// لینکِ دائمیِ ثبت‌نام — نشانی‌ای که شرکت در بیو و کانالش می‌گذارد.
///
/// ⚠️ **دائمی است و به بیمار گره نمی‌خورد.** هر بار که کسی رویش می‌زند یک
/// `IntakeSubmission`ِ تازه ساخته می‌شود. لینکِ یک‌بارمصرفِ per-patient یعنی
/// کسی باید برای هر بیمار دستی لینک بسازد — همان کاری که قرار بود حذف شود.
model IntakeLink {
  id     Int     @id @default(autoincrement())
  token  String  @unique
  title  String
  /// مبلغِ پیش‌فرضِ این لینک — **تومان**، مثلِ `Charge.amount` و `Payment.amount`.
  ///
  /// ⚠️ اولین نسخه ریال بود چون قراردادِ سامانهٔ قبلی را کورکورانه آورده بودم.
  /// عمل‌یار همه‌جا تومان است و دو واحدِ پول در یک سامانه یعنی روزی یک عدد
  /// ده‌برابر یا یک‌دهم در گزارش می‌نشیند.
  amount Int     @default(0)
  active Boolean @default(true)
  notes  String?

  /// کدام فرم پشتِ این لینک است.
  ///
  /// ⚠️ **این تکهٔ گم‌شدهٔ کلِ ماجرا بود.** تا دیروز لینک هیچ ارجاعی به فرم
  /// نداشت و فرمِ عمومی در JSX هاردکد بود؛ یعنی «می‌خواهم برای بیمار فرم
  /// بفرستم، چه فرمی؟» اصلاً جوابی نداشت.
  ///
  /// ⚠️ `Restrict` و نه `SetNull`: اگر فرمِ زیرِ یک لینکِ زنده حذف می‌شد،
  /// `formId` بی‌صدا به null برمی‌گشت و لینک به مسیرِ هاردکدِ قدیمی می‌افتاد —
  /// بدونِ خطا، بدونِ رد در audit، بدونِ هیچ تغییری در فهرستِ ادمین.
  /// نگهبانِ واقعی در `FormsService.removeForm` است؛ این آخرین سد است.
  form   FormDef? @relation(fields: [formId], references: [id], onDelete: Restrict)
  formId Int?     @map("form_id")

  /// حسابی که شماره‌هایش روی باکسِ پرداختِ این لینک نشان داده می‌شود.
  ///
  /// ⚠️ شماره‌ها در خودِ فرم ذخیره **نمی‌شوند**: اگر می‌شدند، عوض‌کردنِ حساب
  /// فرم‌های ساخته‌شده را بازنویسی می‌کرد و فیش‌ها به حسابِ بسته می‌رفت.
  /// `null` یعنی «همان فهرستِ سراسریِ `showOnIntake`» — رفتارِ امروز، تا
  /// لینک‌های موجود بی‌شماره نمانند.
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  bankAccountId Int?         @map("bank_account_id")

  createdAt   DateTime           @default(now()) @map("created_at")
  submissions IntakeSubmission[]

  @@index([formId])
  @@index([bankAccountId])
  @@map("intake_links")
}

/// یک ثبت‌نامِ در جریان — از لحظه‌ای که بیمار روی لینک زد تا تأیید یا رد.
///
/// ⚠️ این **مراجعه نیست.** تا وقتی ادمین تأیید نکرده، `Visit` ساخته نمی‌شود:
/// چیزی که بیمار خودش پر کرده نباید مستقیم وارد دفترِ عملیاتی و مالی شود.
/// پس از تأیید، `visitId` پر می‌شود و همین ردیف سندِ منشأ می‌ماند.
model IntakeSubmission {
  id     Int        @id @default(autoincrement())
  token  String     @unique
  /// nullable شد: ثبت‌نامی که ادمین «از روی کارتِ مراجعه» مستقیم می‌فرستد
  /// لینکِ عمومی ندارد؛ و حذفِ لینک هم ثبت‌نام‌های موجود را نمی‌بلعد
  /// (SetNull) — سابقهٔ پرشده مالِ پرونده است، نه مالِ لینک.
  link   IntakeLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  linkId Int?        @map("link_id")

  /// بخش‌های اختصاصیِ فرمِ پیگیری که به این ثبت‌نام چسبیده‌اند — شناسهٔ
  /// FormDef های followUp=procedure/diagnosisِ منطبق با عملِ بیمار. فیلدهایشان
  /// صفحه‌های بعدیِ همان فرمِ عمومی می‌شوند و پاسخ‌ها در همین `data` می‌نشینند.
  extraFormIds Int[] @default([]) @map("extra_form_ids")

  /// پروفایلِ بیمار از همان لحظهٔ ثبت‌نام ساخته یا پیدا می‌شود (کلید: کد ملی)،
  /// چون فیشِ واریزی باید جایی بنشیند و `Document` بیمار می‌خواهد.
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientId Int?     @map("patient_id")

  /// بعد از تأیید پر می‌شود. یکتا: یک ثبت‌نام حداکثر یک مراجعه می‌سازد.
  visit   Visit? @relation(fields: [visitId], references: [id], onDelete: SetNull)
  visitId Int?   @unique @map("visit_id")

  /// فرمی که بیمار **زیرِ آن** ثبت‌نام کرد — عکسِ لحظه‌ای از `IntakeLink.formId`.
  ///
  /// ⚠️ دقیقاً همان دلیلی که `amount` کپی می‌شود (پایین‌تر): ادمین می‌تواند فردا
  /// فرمِ لینک را عوض کند، و آن‌وقت پاسخ‌هایی که بیمار زیرِ فرمِ A داده با
  /// کلیدهای فرمِ B خوانده می‌شدند — هر جواب زیرِ برچسبِ اشتباه، بی‌هیچ خطایی.
  ///
  /// `SetNull` نه `Restrict`: ثبت‌نامِ گذشته سندِ تاریخی است و نباید جلوی
  /// پاک‌سازیِ یک فرمِ متروک را بگیرد؛ `data` خودش پاسخ‌ها را نگه داشته.
  form   FormDef? @relation(fields: [formId], references: [id], onDelete: SetNull)
  formId Int?     @map("form_id")

  /// pending_fill | pending_payment | pending_approval | approved | rejected | expired
  status String @default("pending_fill")
  /// مبلغِ همین ثبت‌نام — **تومان**. از لینک کپی می‌شود تا تغییرِ بعدیِ لینک
  /// مبلغِ ثبت‌نام‌های در جریان را عوض نکند.
  amount Int    @default(0)

  /// کدِ تخفیفِ اعمال‌شده و مبلغی که کم کرد — **تومان**.
  /// مبلغِ کسرشده ذخیره می‌شود نه محاسبه‌شونده: کدِ تخفیف ممکن است فردا عوض
  /// شود و آن‌وقت معلوم نبود این بیمار چقدر تخفیف گرفت.
  discountCode   String? @map("discount_code")
  discountAmount Int     @default(0) @map("discount_amount")

  /// آنچه بیمار پر کرده — عمداً JSON و نه ستون‌های جدا: این‌ها هنوز **ادعای
  /// بیمار**اند نه دادهٔ تأییدشده. دادهٔ واقعی هنگامِ تأیید به Patient/Visit
  /// می‌رود، جایی که ستونِ درست و اعتبارسنجیِ درست دارد.
  data Json @default("{}")

  reviewNote   String?   @map("review_note")
  reviewedById Int?      @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("intake_submissions")
}

/// کدِ تخفیفِ ثبت‌نام.
///
/// ⚠️ **درصد و مبلغِ ثابت دو ستونِ جدا نیستند، یک `kind` و یک `value`اند.**
/// دو ستونِ nullable یعنی ردیفی که هر دو را پر دارد یا هیچ‌کدام را — و آن
/// وقت باید در کد حدس بزنیم کدام برنده است.
///
/// ⚠️ `usedCount` شمارنده است نه دفتر: چه کسی استفاده کرد از `IntakeSubmission.
/// discountCode` خوانده می‌شود. شمارنده فقط برای سقفِ استفاده است.
model DiscountCode {
  id   Int    @id @default(autoincrement())
  code String @unique

  /// percent | fixed
  kind String @default("percent")
  /// درصد (۱..۱۰۰) یا مبلغِ ثابت به **تومان** — بسته به `kind`.
  value Int

  /// سقفِ تخفیف وقتی درصدی است — **تومان**. صفر یعنی بی‌سقف.
  maxAmount Int @default(0) @map("max_amount")
  /// حداقلِ مبلغِ فاکتور برای اعمال — **تومان**.
  minAmount Int @default(0) @map("min_amount")

  /// صفر یعنی بی‌نهایت.
  maxUses   Int       @default(0) @map("max_uses")
  usedCount Int       @default(0) @map("used_count")
  expiresAt DateTime? @map("expires_at")

  active    Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("discount_codes")
}

/// محلِ تحویل — «کجا گذاشتم / به کجا دادم».
///
/// ⚠️ این جدول برای **قابلِ‌تحلیل‌کردنِ متنِ آزاد** است، نه محدودکردنِ کاربر.
/// کارشناس هرچه بخواهد می‌نویسد؛ اگر با یکی از این‌ها یکی درآمد، شکلِ کانونی
/// ذخیره می‌شود. `key` نتیجهٔ `placeKey()` است و یکتا، تا «CSR» و «سی اس آر»
/// دو ردیف نشوند.
model DeliveryPlace {
  id   Int    @id @default(autoincrement())
  name String
  key  String @unique

  /// املاهای دیگرِ همین محل — کلیدِ کانونی‌شده، نه متنِ خام.
  ///
  /// ⚠️ **حدس‌زدنی نیست، گفتنی است.** «سی اس آر» و «CSR» یک جا هستند ولی هیچ
  /// نرمال‌سازیِ متنی این را نمی‌فهمد؛ آوانویسی است نه تفاوتِ فاصله و نویسه.
  /// همان درسِ `HospitalAlias`: تصمیمِ آدم ذخیره می‌شود تا دفعهٔ بعد نپرسد.
  aliasKeys String[] @default([]) @map("alias_keys")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("delivery_places")
}

/// پس‌کی/اثر انگشت (WebAuthn) — هر کاربر می‌تواند چند دستگاه ثبت کند
model WebauthnCredential {
  id         Int      @id @default(autoincrement())
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId  Int      @map("account_id")
  credId     String   @unique @map("cred_id") // base64url
  publicKey  String   @map("public_key") // base64
  counter    Int      @default(0)
  transports String?
  name       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([accountId])
  @@map("webauthn_credentials")
}

/// سشن‌های چندتایی (حداکثر ۱۰ همزمان) — معادلِ account_sessions
model Session {
  id        String    @id @default(uuid())
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId Int       @map("account_id")
  tokenHash String    @map("token_hash")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([accountId])
  @@map("account_sessions")
}

/// تنظیماتِ سطحِ شرکت — کلید/مقدارِ ساده.
///
/// عمداً KV است نه ستون‌های ثابت: چیزهایی که این‌جا می‌نشینند (حوزهٔ کاری، نامِ
/// برند، بعداً رنگ و لوگو) کم‌تعداد و کم‌تغییرند و هرکدام یک migration ارزش ندارد.
/// هر چیزی که رویش گزارش می‌گیریم یا join می‌کنیم باید جدولِ خودش را داشته باشد،
/// نه این‌جا.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("settings")
}

/// دسترسیِ ماژول‌ها — قابلِ‌تنظیم توسط سوپرادمین (پیش‌فرض‌ها از کد seed می‌شوند).
/// enabled بعداً اهرمِ لایسنس/پلنِ SaaS هم می‌شود.
model Feature {
  id       Int     @id @default(autoincrement())
  key      String  @unique
  minLevel Int     @default(6) @map("min_level") // حداقل سطحِ لازم (۱..۶)
  enabled  Boolean @default(true)
  /// نقش‌های مجاز (کلیدهای JOB_ROLES) — **AND با سطح**: خالی یعنی «هر نقشی».
  /// دو نفرِ هم‌سطح می‌توانند دسترسیِ متفاوت بگیرند («خدمتِ مالی فقط منشی»).
  roles     Json     @default("[]")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("features")
}

/// مجوزهای ریزدانهٔ عملیات؛ Feature فقط روشن/خاموش بودن ماژول است.
model Permission {
  id       Int     @id @default(autoincrement())
  key      String  @unique
  minLevel Int     @default(6) @map("min_level")
  enabled  Boolean @default(true)
  /// همان قراردادِ Feature.roles — AND با سطح؛ خالی = بدونِ قیدِ نقش.
  roles     Json     @default("[]")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("permissions")
}

/// ردپای تغییرات حساس؛ این جدول از API عمومی حذف نمی‌شود.
model AuditEvent {
  id         BigInt   @id @default(autoincrement())
  actorId    Int?     @map("actor_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

/// پروندهٔ بیمار — یک نفر، یک پرونده، چند مراجعه. کدِ خوانا: AM-NNNN
///
/// این رکورد «پوشهٔ» بیمار است: مراجعات، مدارک و شرح‌ها همه به همین id می‌چسبند،
/// حتی وقتی به یک مراجعهٔ مشخص هم مربوط باشند. پس هیچ مدرکی بی‌پرونده نمی‌ماند و
/// «همهٔ سابقهٔ این بیمار» یک query است، نه جمع‌کردن از چند جا.
///
/// تفکیکِ عمومی/بالینی عمداً در سطحِ مجوز است نه جدول: فیلدهای هویتی با
/// `patients.read` و فیلدهای بالینی (حساسیت، سابقه، بیمه) با
/// `patients.clinical.read`. سرویس دو نمای متفاوت می‌سازد، نه یک نما با فیلدهای
/// خالی — چیزی که کاربر اجازه‌اش را ندارد اصلاً از DB بیرون نمی‌آید.
model Patient {
  labOrders      LabOrder[]
  imagingOrders  ImagingOrder[]
  consultOrders  ConsultOrder[]
  referralOrders ReferralOrder[]
  id         Int       @id @default(autoincrement())
  code       String    @unique // AM-0001
  /// ردِ منبع برای دادهٔ وارد‌شده از سامانهٔ قبلی — «malekteb:patient_profiles:۴۲».
  /// وجودش وارد کردن را قابلِ تکرار می‌کند: دفعهٔ دوم ردیفِ تکراری ساخته نمی‌شود.
  /// یکتا نیست چون ممکن است دو منبع به یک بیمار برسند؛ یکتاییِ واقعی با کد ملی است.
  sourceRef  String?   @map("source_ref")
  firstName  String    @map("first_name")
  lastName   String    @map("last_name")
  phone      String?
  /// کلیدِ هویتِ بیمار. یکتا یعنی «هر کد ملی، یک پرونده» — همان اصلِ MPI.
  /// nullable می‌ماند چون بیمارِ اورژانسی یا اتباع ممکن است کد ملی نداشته باشد؛
  /// در Postgres چند NULL با ایندکسِ یکتا سازگارند.
  nationalId String?   @unique @map("national_id")

  /// توکنِ «پروندهٔ الکترونیک» — لینکِ دائمیِ بیمار (/p/<token>): تاریخچهٔ
  /// مراجعات، مراجعاتِ آتی، عمل‌ها و همهٔ اطلاع‌رسانی‌ها یک‌جا. تنبل ساخته
  /// می‌شود؛ راهِ ارتباطیِ ثابتِ ما با بیمار است، پس هرگز عوض نمی‌شود.
  portalToken String? @unique @map("portal_token")
  birthDate  DateTime? @map("birth_date")

  // ── جمعیت‌شناختی ──
  gender  String? // male | female
  city    String?
  address String?

  // ── بالینیِ پایه ──
  bloodType         String? @map("blood_type") // A+ … O-
  /// فعلاً متنِ آزاد. ساختاری‌کردنشان (مثل ProcedureType) وقتی ارزش دارد که رویشان
  /// هشدار یا گزارش بسازیم؛ تا آن روز، متنِ آزاد صادقانه‌تر از فهرستِ ناقصِ اجباری است.
  allergies         String?
  chronicConditions String? @map("chronic_conditions")
  medications       String?

  // ── بیمه ──
  insurer             String?
  insuranceNo         String? @map("insurance_no")
  supplementalInsurer String? @map("supplemental_insurer")

  // ── تماسِ اضطراری ──
  emergencyName     String? @map("emergency_name")
  emergencyPhone    String? @map("emergency_phone")
  emergencyRelation String? @map("emergency_relation")

  notes String?

  /// **چطور با ما آشنا شد** — کانالی که این بیمار را آورد.
  ///
  /// ⚠️ جدولِ جدا دارد و در JSON نمی‌نشیند، چون رویش **گزارش می‌گیریم**:
  /// «کدام کانال بیمار می‌آورد» عددی است که تصمیمِ تبلیغات را می‌سازد. همان
  /// قاعدهٔ پروژه — چیزی که رویش گزارش می‌گیریم یا join می‌کنیم باید ستون باشد.
  ///
  /// ⚠️ روی **بیمار** است نه مراجعه: آدم یک‌بار با ما آشنا می‌شود، نه در هر
  /// مراجعه از نو.
  referralSource   ReferralSource? @relation(fields: [referralSourceId], references: [id], onDelete: SetNull)
  referralSourceId Int?            @map("referral_source_id")
  /// نامِ معرف، وقتی کانال «معرفیِ پزشک/بیمار» باشد — متنِ آزاد چون ممکن است
  /// معرف بیرونِ سامانه باشد.
  referralNote     String?         @map("referral_note")
  surveyInvites    SurveyInvite[]

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  deletedById  Int?      @map("deleted_by_id")
  deleteReason String?   @map("delete_reason")

  visits        Visit[]
  documents     Document[]
  clinicalNotes ClinicalNote[]

  @@index([phone])
  @@index([sourceRef])
  @@map("patients")

  /// ثبت‌نام‌هایی که به این پرونده رسیده‌اند.
  intakes IntakeSubmission[]

  /// نوبت‌های این بیمار (`docs/BOOKING.md`).
  appointments Appointment[]
  reminders Reminder[]
}

/// مدرکِ پزشکی — آزمایش، تصویربرداری، گزارش، رضایت‌نامه، مدرکِ هویتی…
///
/// خودِ فایل هرگز در DB نمی‌نشیند: روی دیسک با نامِ sha256 ذخیره می‌شود و فقط از
/// طریقِ endpointِ احرازشده سرو می‌شود. دلیل: یک CT چند ده مگابایت است؛ dataURL
/// در DB هم backup را می‌ترکاند هم هر query روی بیمار را سنگین می‌کند.
model Document {
  id        Int     @id @default(autoincrement())
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId Int     @map("patient_id")
  /// اختیاری: مدرک یا به کلِ پرونده مربوط است یا به یک مراجعهٔ مشخص.
  visit     Visit?  @relation(fields: [visitId], references: [id], onDelete: SetNull)
  visitId   Int?    @map("visit_id")

  category String // lab | imaging | report | consent | identity | receipt | other
  title    String?
  fileName String    @map("file_name") // نامِ اصلیِ کاربر — فقط نمایش و دانلود
  mimeType String    @map("mime_type")
  size     Int
  /// هم نامِ فایل روی دیسک است هم کلیدِ یکسانی؛ آپلودِ تکراری فضای تازه نمی‌گیرد.
  sha256   String
  /// مدرکِ «لینکی» — MRI/پاراکلینیکی که جای دیگری میزبانی می‌شود (پکس، درایو…).
  /// وقتی پُر است فایلی روی دیسک نیست: sha256 خالی و size صفر می‌ماند و
  /// دانلود به‌جای استریم همین نشانی را برمی‌گرداند.
  externalUrl String? @map("external_url")
  /// تاریخِ خودِ آزمایش/تصویربرداری، نه تاریخِ آپلود — مدرکِ پارسال ممکن است
  /// امروز آپلود شود و مرتب‌سازیِ زمانیِ پرونده باید بالینی باشد نه اداری.
  takenAt  DateTime? @map("taken_at")

  uploadedById Int?      @map("uploaded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")
  deletedById  Int?      @map("deleted_by_id")

  @@index([patientId, category])
  @@index([visitId])
  @@index([sha256])
  @@map("documents")
}

/// قلمِ صورت‌حساب.
///
/// جایگزینِ دو ستونِ `amount`/`paid` که روی Visit بودند. آن دو ستون برای
/// نورومانیتورینگ هم نازک بودند (سهمِ جراح و کارشناس و شرکا جا نمی‌شد) و برای
/// شرکتِ ست و پیچ که به‌ازای هر قلمِ کالا فاکتور می‌کند اصلاً کار نمی‌کردند.
/// با ردیف‌های مستقل، «چه چیزی چقدر شد» تاریخچه دارد نه یک عددِ سرجمع.
///
/// ⚠️ `amount` علامت‌دار است: تخفیف ردیفی با مبلغِ منفی است، نه یک حالتِ خاص در
/// محاسبه. این‌طور جمعِ کل همیشه `sum(amount)` می‌ماند و هیچ render ای فرمول ندارد.
model Charge {
  id      Int   @id @default(autoincrement())
  visit   Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  visitId Int   @map("visit_id")

  /// service | item | discount
  kind        String  @default("service")
  title       String
  /// کدِ خدمت — عکسِ لحظهٔ صدور، نه رابطه: فاکتورِ صادرشده نباید با
  /// ویرایشِ بعدیِ کتاب یا کدهای داخلی تغییر کند، و بیمه همین رشته را می‌خواهد.
  serviceCode String? @map("service_code")
  /// نظامِ کد: `book` (کتابِ ارزش نسبی) | `internal` (کدِ داخلیِ مطب).
  /// فقط وقتی serviceCode پر است معنا دارد؛ null یعنی قلمِ بی‌کد.
  codeSystem  String? @map("code_system")
  /// کالای مصرف‌شده — رابطه است (برای گزارشِ مصرف) ولی نام و مبلغ کپی می‌شوند.
  item        Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemId      Int?    @map("item_id")
  /// اثرِ این قلم روی انبار — **صریح**، چون «قلمِ بدونِ حرکتِ انبار» سه معنیِ
  /// کاملاً متفاوت دارد و بدونِ ثبتِ نیت، مغایرت‌گیری ناممکن است:
  ///   `consumed` — کالای واقعیِ ما، از انبار کم می‌شود (lotId اجباری)
  ///   `virtual`  — فقط روی فاکتور می‌آید: خدمت، قیمتِ توافقی، قلمِ تجمیعی
  ///   `hospital` — کالای خودِ بیمارستان؛ فاکتور می‌کنیم، انبارِ ما دست نمی‌خورد
  ///
  /// بدونِ این فیلد، «قلمِ مجازیِ عمدی» از «کاربر یادش رفت لات را انتخاب کند»
  /// قابلِ تشخیص نبود — و هر دو در دیتابیس دقیقاً یک شکل داشتند.
  stockEffect String  @default("virtual") @map("stock_effect")
  quantity    Int     @default(1)
  unitPrice   Int     @map("unit_price") // تومان
  /// quantity × unitPrice، ذخیره‌شده تا تغییرِ بعدیِ قیمت، فاکتورِ قدیمی را عوض نکند.
  amount      Int // تومان (علامت‌دار)
  /// Server-calculated professional/technical tariff snapshot for IONM services.
  neuroDetail Json? @map("neuro_detail")

  notes       String?
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([visitId])
  @@index([itemId])
  @@index([stockEffect])
  @@map("charges")
}

/// پرداخت — هر دریافتِ واقعی از بیمار یا بیمه.
///
/// جدا از Charge است چون سؤال‌های متفاوتی جواب می‌دهد: Charge می‌گوید «چقدر
/// بدهکار است»، Payment می‌گوید «چقدر و کِی و چطور داد». یک عددِ `paid` هیچ‌کدام
/// از این‌ها را نگه نمی‌داشت.
model Payment {
  id      Int   @id @default(autoincrement())
  visit   Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  visitId Int   @map("visit_id")

  amount    Int // تومان
  /// cash | card | transfer | cheque | insurance
  method    String   @default("cash")
  paidAt    DateTime @map("paid_at")
  /// شمارهٔ پیگیری/ارجاع — برای تطبیق با صورت‌حسابِ بانک.
  reference String?

  /// به کدام حساب واریز شد.
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  bankAccountId Int?         @map("bank_account_id")
  /// ⚠️ اگر پول به حسابِ **شخصیِ** یک شریک رفت، همین‌جا ثبت می‌شود. مبنای
  /// «چه کسی نقد را در دست دارد» و در نتیجه بدهیِ بینِ شرکا. خالی یعنی به
  /// حسابِ مشترکِ شرکت رفته و بدهیِ بینِ شرکا نمی‌سازد.
  receivedBy    Partner?     @relation("PaymentReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  receivedById  Int?         @map("received_by_id")

  notes       String?
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([visitId])
  @@index([paidAt])
  @@map("payments")
}

/// شرحِ بالینی — شرحِ ویزیت، شرحِ عمل، سیرِ بیماری، خلاصهٔ ترخیص.
///
/// ⚠️ رکوردها تغییرناپذیرند. «ویرایش» رکوردِ تازه‌ای می‌سازد که به قبلی اشاره
/// می‌کند و قبلی `replacedAt` می‌گیرد. پروندهٔ پزشکی سندی است که باید بشود ثابت
/// کرد چه زمانی چه چیزی نوشته شده بود؛ UPDATE روی متنِ بالینی آن تاریخچه را
/// نابود می‌کند. نمایشِ پیش‌فرض فقط نسخه‌های جاری است (`replacedAt IS NULL`).
model ClinicalNote {
  id        Int     @id @default(autoincrement())
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId Int     @map("patient_id")
  visit     Visit?  @relation(fields: [visitId], references: [id], onDelete: SetNull)
  visitId   Int?    @map("visit_id")

  kind String // visit | op | progress | discharge | consult
  body String

  authorId   Int?    @map("author_id")
  /// عکسِ لحظهٔ نگارش — نویسندهٔ سند باید معلوم بماند حتی اگر حسابش حذف شود.
  authorName String? @map("author_name")

  replacesId Int?          @unique @map("replaces_id")
  replaces   ClinicalNote? @relation("NoteVersion", fields: [replacesId], references: [id], onDelete: SetNull)
  replacedBy ClinicalNote? @relation("NoteVersion")
  replacedAt DateTime?     @map("replaced_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([patientId, kind])
  @@index([visitId])
  @@map("clinical_notes")
}

/// مراجعه (Visit) — واحدِ اصلیِ کار: عمل/خدمت برای یک بیمار
/// ⚠️ همهٔ مبالغ «تومان» و عددِ صحیح‌اند (قانونِ تک‌واحدی — درسِ ملک‌طب)
model Visit {
  /// Patient-specific plan, not consumption or invoice charges. Null uses procedure defaults.
  requiredItems Json? @map("required_items")
  surgeonInstructions String? @map("surgeon_instructions")
  invoices       InvoiceDocument[]
  labOrders      LabOrder[]
  imagingOrders  ImagingOrder[]
  consultOrders  ConsultOrder[]
  referralOrders ReferralOrder[]
  id        Int     @id @default(autoincrement())
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId Int     @map("patient_id")
  seq       Int     @default(1) // شمارهٔ مراجعهٔ بیمار → کدِ AM-0001-V2

  /// نوعِ ملاقات: surgery | clinic | followup | consult
  ///
  /// در نورومانیتورینگ هر مراجعه یک عمل است، پس این ستون امروز تقریباً همیشه
  /// `surgery` است — ولی آن انطباق تصادفِ همین حوزه است، نه یک قاعده. مسیرِ
  /// «مطب → عمل → پس از عمل» چند ملاقاتِ متفاوت روی یک پرونده دارد و اگر این
  /// ستون نبود، اولین پیگیریِ پس از عمل به‌شکلِ متنِ آزاد در یادداشت ثبت می‌شد؛
  /// دقیقاً همان اشتباهی که با opType داشتیم و بعداً درآوردنش سخت است.
  ///
  /// ⚠️ نامِ ستون‌های op* (opDate/opStatus/opType) عمداً دست‌نخورده ماند: تغییرِ
  /// نامشان یک migrationِ پرریسک روی همهٔ نصب‌هاست و ارزشِ فعلی‌اش را ندارد.
  /// برچسبِ کاربرپسند بر اساسِ kind در UI ساخته می‌شود، نه از نامِ ستون.
  kind         String    @default("surgery")
  // عکسِ لحظهٔ ثبت — فقط وقتی خوانده می‌شود که رابطه از بین رفته باشد (جراح/بیمارستانِ
  // حذف‌شده). عمداً با تغییرِ نامِ موجودیت به‌روز نمی‌شود؛ عکسی که بازنویسی شود عکس نیست.
  surgeonName  String?   @map("surgeon_name")
  hospitalName String?   @map("hospital_name")
  opType       String?   @map("op_type") // عکسِ لحظه‌ای از نامِ نوعِ عمل
  surgeon      Surgeon?  @relation(fields: [surgeonId], references: [id], onDelete: SetNull)
  surgeonId    Int?      @map("surgeon_id")
  hospital     Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  hospitalId   Int?      @map("hospital_id")
  tech         Account?  @relation("VisitTech", fields: [techId], references: [id], onDelete: SetNull)
  techId       Int?      @map("tech_id") // کارشناسِ منتسب (از accounts)

  procedureType   ProcedureType? @relation(fields: [procedureTypeId], references: [id], onDelete: SetNull)
  procedureTypeId Int?           @map("procedure_type_id")
  diagnosis       Diagnosis?     @relation(fields: [diagnosisId], references: [id], onDelete: SetNull)
  diagnosisId     Int?           @map("diagnosis_id")

  /// موضوعِ ویزیت — اولیه / پست‌آپ / زیبایی. `SetNull` چون حذفِ یک موضوع
  /// نباید مراجعهٔ ثبت‌شده را ببرد؛ مراجعه بی‌موضوع می‌شود، نه ناپدید.
  topic   VisitTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  topicId Int?        @map("topic_id")

  opDate   DateTime? @map("op_date") // تاریخِ عمل

  /// پیگیریِ **اختصاصیِ همین بیمار** — جراح بعد از عمل همان‌جا تعیین می‌کند؛
  /// خالی = قالب/روزهای نوعِ عمل (تعریف‌های پایه). override است نه کپی:
  /// تغییرِ بعدیِ قالبِ عمومی روی بیمارانی که متنِ اختصاصی دارند اثر نمی‌کند.
  /// تصمیمِ درمانیِ این ویزیت — چندتایی (آزمایش + مشاوره هم‌زمان ممکن است):
  /// surgery | conservative | referral | consult | lab | imaging
  decisions     String[] @default([])

  /// ویزیتِ پست‌آپِ خودکار: این مراجعه «اولین مراجعهٔ بعد از» کدام عمل است؟
  /// حذفِ عمل، این را مستقل می‌کند (SetNull) — نه اینکه ویزیت را ببرد.
  followOfVisitId Int?    @map("follow_of_visit_id")
  followOf        Visit?  @relation("PostOpChain", fields: [followOfVisitId], references: [id], onDelete: SetNull)
  followers       Visit[] @relation("PostOpChain")

  @@index([followOfVisitId])
  /// مراقبتِ قبل از عمل — اختصاصیِ همین بیمار؛ خالی = قالبِ نوعِ عمل
  preOpCare     String? @map("pre_op_care")
  /// مراقبتِ قبل از عمل **علاوه بر** موعدِ مقرر، همین حالا هم برود
  /// (ثبتِ چندروز‌قبل: بیمار باید فوراً بداند، ولی یادآوریِ نزدیکِ عمل هم لازم است)
  preOpImmediate Boolean @default(false) @map("pre_op_immediate")
  postOpCare    String? @map("post_op_care")
  /// پیامکِ مراقبت بلافاصله بعد از ثبتِ فرم برود، نه فردای عمل
  postOpImmediate Boolean @default(false) @map("post_op_immediate")
  followUpDays  String? @map("follow_up_days")
  opStatus String    @default("pending") @map("op_status") // pending | done | cancelled

  /// توکنِ لینکِ عمومیِ «خلاصهٔ ویزیت» — تنبل ساخته می‌شود، اولین باری که
  /// ادمین خلاصه را باز می‌کند یا برای بیمار می‌فرستد. صفحهٔ عمومی هیچ
  /// عددِ مالی‌ای ندارد؛ همان قاعدهٔ توکنِ فرمِ بیمار.
  summaryToken String? @unique @map("summary_token")

  /// «ویزیتِ بعدی» که پزشک روی خودِ فرم ثبت می‌کند — «دو هفتهٔ دیگر بیاید».
  ///
  /// ⚠️ ستونِ واقعی و نه کلیدی در `extra`: فازِ یادآوری‌ها (docs/BOOKING.md)
  /// باید «چه کسی هفتهٔ بعد سررسید دارد» را با یک WHERE بپرسد؛ تاریخِ
  /// دفن‌شده در JSON یعنی هر یادآوری یک full-scan و هر گزارش یک استثنا.
  nextVisitDate DateTime? @map("next_visit_date")

  /// مدلِ قیمت‌گذاریِ فاکتورِ این مراجعه (الگوی ملک‌طب):
  /// - `coded`: جمعِ اقلام (کدهای عمل × تعرفه + مصرفی‌ها) = مبلغِ فاکتور
  /// - `global`: مبلغِ کلِ توافقی (`globalAmount`) مبناست؛ اقلام و کدها فقط
  ///   برای نمایش/چاپ ثبت می‌شوند و جمعشان ملاک نیست.
  invoiceType String? @map("invoice_type")
  invoiceBankAccountId Int? @map("invoice_bank_account_id")
  invoiceBankAccount BankAccount? @relation("InvoiceBank", fields: [invoiceBankAccountId], references: [id], onDelete: Restrict)
  pricingModel String @default("coded") @map("pricing_model")
  /// مبلغِ کلِ توافقی به تومان — فقط وقتی pricingModel = global معنا دارد.
  globalAmount Int?   @map("global_amount")

  /// ساعتِ شروع/پایانِ عمل و ساعتِ حضورِ کارشناس — «HH:MM» بیست‌وچهارساعته.
  ///
  /// ⚠️ عمداً رشته است نه DateTime: این‌ها ساعتِ روی ساعتِ دیوارِ اتاقِ عمل‌اند،
  /// نه لحظه‌ای روی خطِ زمان. ذخیره‌شان به‌شکلِ DateTime یعنی چسباندنشان به
  /// opDate و بعد گرفتارِ منطقهٔ زمانی شدن — عملی که ۲۳:۳۰ شروع شده با یک
  /// جابه‌جاییِ ساعت به روزِ دیگر می‌پرد. مدتِ عمل مشتق است و در enrich می‌آید.
  /// ردِ منبعِ وارد‌کردن — همان استدلالِ Patient.sourceRef.
  sourceRef        String?   @map("source_ref")
  opStartTime      String?   @map("op_start_time")
  opEndTime        String?   @map("op_end_time")
  /// ساعتِ حضورِ کارشناس در بیمارستان (از پنلِ چینش).
  techArriveTime   String?   @map("tech_arrive_time")
  /// ساعتی که بار باید در بیمارستان باشد — معمولاً چند ساعت قبل از عمل، چون
  /// ست باید در CSR استریل شود. جدا از `techArriveTime` است: راننده و کارشناس
  /// دو ساعتِ متفاوت دارند و یکی‌کردنشان یعنی یکی‌شان همیشه غلط است.
  cargoDueTime     String?   @map("cargo_due_time")
  /// آخرین باری که ساعت‌ها ثبت/اصلاح شدند — برای تایم‌لاینِ پنلِ کارشناسی.
  opTimesUpdatedAt DateTime? @map("op_times_updated_at")

  notes       String?

  /// پاسخِ **فیلدهای دلخواه** این مراجعه — کلیدِ فیلد به مقدار.
  ///
  /// ⚠️ فقط فیلدهای دلخواه. فیلدهای هسته‌ای (جراح، تاریخ، بیمارستان، مبلغ) ستونِ
  /// واقعیِ خودشان را دارند و هرگز این‌جا نمی‌آیند — حتی با اینکه هر دو از یک
  /// `FormDef` می‌آیند. دلیل همان قاعدهٔ پروژه است: چیزی که رویش گزارش می‌گیریم
  /// یا join می‌کنیم باید ستون باشد. فیلدِ دلخواه گزارش‌پذیر نیست چون هر شرکت
  /// کلیدهای خودش را می‌سازد.
  ///
  /// ⚠️ همان قرارِ `IntakeSubmission.data` — شکلِ داده را کاربر تعیین می‌کند،
  /// نه ما. اگر روزی فیلدی آن‌قدر مهم شد که گزارش خواست، راهِ درست ساختنِ ستون
  /// و مهاجرتِ مقادیر است، نه گزارش‌گرفتن از JSON.
  extra       Json     @default("{}")

  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  /// **طرفِ حسابِ فاکتور** — `patient` یا `hospital`.
  ///
  /// در هسته می‌ماند حتی با اینکه گردشِ کارِ قراردادی به ماژولِ جدا رفته: «مانده»
  /// بی‌معنی است تا معلوم نباشد طلب از کیست. تشخیصِ خودکارش از روی قرارداد کارِ
  /// ماژولِ «سفارش‌های قراردادی» است؛ این‌جا دستی انتخاب می‌شود.
  payer           String    @default("patient")
  payerHospital   Hospital? @relation("VisitPayer", fields: [payerHospitalId], references: [id], onDelete: SetNull)
  payerHospitalId Int?      @map("payer_hospital_id")

  /// استثنای قراردادِ جراح برای همین مراجعه — `percent` یا `fixed`، وگرنه null
  /// و قراردادِ جاری اعمال می‌شود. جدا از خودِ قرارداد است چون استثنا نباید
  /// قراردادِ بقیهٔ عمل‌ها را عوض کند.
  surgeonShareKind  String? @map("surgeon_share_kind")
  surgeonShareValue Int?    @map("surgeon_share_value")
  /// هزینهٔ مستقیمِ این کیس (تومان) — تا ماژولِ هزینه‌ها بیاید، دستی وارد می‌شود.
  caseCost          Int?    @map("case_cost")

  documents      Document[]
  clinicalNotes  ClinicalNote[]
  surveyInvites  SurveyInvite[]
  charges        Charge[]
  payments       Payment[]
  stockMovements StockMovement[]
  stockTransfers StockTransfer[]
  settlements    Settlement[]
  payouts        Payout[]

  @@unique([patientId, seq])
  @@index([patientId])
  @@index([kind])
  @@index([opStatus])
  @@index([opDate])
  @@index([surgeonId]) // پورتالِ جراح: «مراجعه‌های من»
  @@index([procedureTypeId])
  @@index([diagnosisId])
  @@index([sourceRef])
  @@map("visits")

  /// ثبت‌نامی که این مراجعه از آن ساخته شد (اگر از فرمِ بیمار آمده باشد).
  intake IntakeSubmission?

  /// نوبتی که این مراجعه از آن ساخته شد — یک‌به‌یک.
  appointment Appointment?
  reminders Reminder[]
}

/// Issued versions are immutable; a later version supersedes, never rewrites, one.
model InvoiceDocument {
  id           Int      @id @default(autoincrement())
  visitId      Int      @map("visit_id")
  visit        Visit    @relation(fields: [visitId], references: [id], onDelete: Restrict)
  variant      String
  number       String   @unique
  fingerprint  String
  snapshot     Json
  createdById  Int?     @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  supersededAt DateTime? @map("superseded_at")

  @@index([visitId, variant, id])
  @@map("invoice_documents")
}

/// کدهای یکبارمصرفِ ثبت‌نام/تأیید موبایل
model OtpCode {
  id         Int       @id @default(autoincrement())
  phone      String
  codeHash   String    @map("code_hash")
  purpose    String    @default("signup") // signup | ...
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone])
  @@map("otp_codes")
}

// ═══════════════════════ حسابداری — تقسیمِ سهم ═══════════════════════

/// قراردادِ جراح — درصدی یا مبلغِ ثابت.
///
/// ⚠️ **تاریخ‌دار** است و ردیفِ قدیمی ویرایش نمی‌شود. قرارداد در طولِ زمان عوض
/// می‌شود و عملِ پارسال باید با قراردادِ پارسال حساب شود؛ اگر یک ردیف را جای
/// خودش بازنویسی کنیم، محاسبهٔ دوبارهٔ یک تسویهٔ قدیمی عددِ دیگری می‌دهد و هیچ
/// راهی نمی‌ماند بفهمیم کدام درست بود.
model SurgeonContract {
  id        Int     @id @default(autoincrement())
  surgeon   Surgeon @relation(fields: [surgeonId], references: [id], onDelete: Cascade)
  surgeonId Int     @map("surgeon_id")

  /// percent | fixed
  kind    String
  /// درصدِ صحیح (۰..۱۰۰) وقتی kind=percent
  percent Int?
  /// مبلغِ ثابت به تومان وقتی kind=fixed
  amount  Int?

  effectiveFrom DateTime @map("effective_from")
  active        Boolean  @default(true)
  notes         String?
  createdById   Int?     @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([surgeonId, effectiveFrom])
  @@map("surgeon_contracts")
}

/// سهامدارِ شرکت — جایگزینِ `partners_config` که در ملک‌طب یک JSON در settings بود.
///
/// جدول است نه JSON چون هر سهم در دفترِ تسویه به یک ردیف ارجاع می‌دهد؛ با JSON،
/// «شریکِ حذف‌شده» ارجاعِ شکسته می‌شد. درصدها باید جمعاً ۱۰۰ شوند و سرویس این را
/// کنترل می‌کند — نه UI، چون API هم مستقیم صدا زده می‌شود.
model Partner {
  id        Int      @id @default(autoincrement())
  name      String
  /// درصدِ صحیح. جمعِ شریک‌های فعال باید دقیقاً ۱۰۰ باشد.
  percent   Int
  color     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  accounts BankAccount[]
  expenses Expense[]
  received Payment[]     @relation("PaymentReceiver")

  @@map("partners")
}

/// تسویهٔ یک مراجعه — یک نسخهٔ کاملِ محاسبه‌شده.
///
/// ⚠️ **نسخه‌دار و فقط‌افزودنی.** محاسبهٔ دوباره ردیفِ قبلی را عوض نمی‌کند؛ نسخهٔ
/// تازه می‌سازد و قبلی `supersededAt` می‌خورد. دلیلش همان دلیلِ دفترِ انبار است:
/// عددِ مالی که بازنویسی شود، «چرا آن‌موقع این عدد بود» را برای همیشه می‌برد.
///
/// ورودی‌های محاسبه (درآمد، هزینه) این‌جا **عکس** می‌شوند، نه اینکه هر بار از
/// فاکتور خوانده شوند: تسویه‌ای که با تغییرِ بعدیِ فاکتور بی‌سروصدا عوض شود،
/// تسویه نیست.
model Settlement {
  id      Int   @id @default(autoincrement())
  visit   Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  visitId Int   @map("visit_id")
  version Int

  /// draft | final — تا وقتی final نشده، عددِ پیشنهادی است نه مرجع.
  /// عمداً پیش‌فرضش draft است: دورهٔ سایه، تا وقتی عددها با سامانهٔ قبلی یکی شوند.
  status String @default("draft")

  /// عکسِ لحظهٔ محاسبه — تومان.
  revenue Int
  cost    Int @default(0)

  supersededAt DateTime? @map("superseded_at")
  finalizedAt  DateTime? @map("finalized_at")
  notes        String?
  createdById  Int?      @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  entries ShareEntry[]

  @@unique([visitId, version])
  @@index([visitId, supersededAt])
  @@map("settlements")
}

/// یک سهم از یک تسویه.
///
/// `partyId` عمداً رابطه نیست: حذفِ جراح یا کارشناس نباید سابقهٔ مالی را پاک کند.
/// نام و مبنای محاسبه در همان لحظه **کپی** می‌شوند، پس تغییرِ بعدیِ قرارداد یا
/// درصدِ شریک، دفترِ گذشته را دست نمی‌زند.
model ShareEntry {
  id           Int        @id @default(autoincrement())
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  settlementId Int        @map("settlement_id")

  /// surgeon | tech | partner | cost
  party     String
  partyId   Int?   @map("party_id")
  partyName String @map("party_name")
  /// تومان — علامت‌دار: هزینه منفی است تا جمعِ همهٔ ردیف‌ها همیشه صفر شود.
  amount    Int
  /// عکسِ مبنا: {"kind":"percent","percent":30,"of":120000000} یا {"kind":"fixed"}
  /// بدونِ این، «چرا این عدد» فقط با بازسازیِ کلِ محاسبه جواب داده می‌شود.
  basis     Json?

  @@index([settlementId])
  @@index([party, partyId])
  @@map("share_entries")
}

/// حسابِ بانکیِ شرکت یا شریک — مقصدِ دریافت و مبدأ پرداخت.
model BankAccount {
  classification String @default("unclassified")
  invoices Visit[] @relation("InvoiceBank")
  id         Int      @id @default(autoincrement())
  ownerName  String   @map("owner_name")
  bankName   String?  @map("bank_name")
  cardNumber String?  @map("card_number")
  iban       String?
  /// شمارهٔ حسابِ بانکی — جدا از کارت و شبا.
  ///
  /// ⚠️ سه شمارهٔ متفاوت‌اند و بیمار گاهی فقط یکی‌شان را می‌تواند استفاده کند:
  /// کارت برای انتقالِ کارت‌به‌کارت، شبا برای پایا/ساتنا، و شمارهٔ حساب برای
  /// واریزِ حضوری در شعبه. نبودش یعنی بیمارِ شعبه‌رو نمی‌تواند واریز کند.
  ///
  /// ⚠️ طولِ حساب بینِ بانک‌های ایران یکسان نیست، پس سقف مثلِ شبا (۳۴) گرفته
  /// شده نه تنگ‌تر — سقفِ تنگ یک ۴۰۰ می‌سازد که کاربر دلیلش را نمی‌فهمد.
  accountNumber String? @map("account_number")
  /// اگر حسابِ شخصیِ یک شریک است — مبنای «چه کسی پول را گرفت».
  partner    Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  partnerId  Int?     @map("partner_id")

  /// روی فرمِ عمومیِ ثبت‌نام به بیمار نشان داده شود؟
  ///
  /// ⚠️ **پیش‌فرض خاموش و opt-inِ صریح.** این تنها جایی است که شمارهٔ حساب
  /// عمداً از یک نشانیِ بی‌احراز خوانده می‌شود؛ اگر پیش‌فرض روشن بود، اولین
  /// حسابِ شخصیِ یک شریک هم روی اینترنت می‌رفت. بدونِ هیچ حسابِ علامت‌خورده،
  /// فرمِ بیمار شمارهٔ حساب ندارد — که دقیقاً باگِ امروز بود، ولی راهِ حلش
  /// «همه را نشان بده» نیست.
  showOnIntake Boolean @default(false) @map("show_on_intake")
  active     Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  payments Payment[]
  expenses Expense[]
  payouts  Payout[]
  cheques  Cheque[]
  /// لینک‌های ثبت‌نامی که شماره‌های همین حساب را به بیمار نشان می‌دهند.
  intakeLinks IntakeLink[]

  @@map("bank_accounts")
}

/// هزینهٔ جانبیِ شرکت — اجاره، حقوق، حمل‌ونقل، تعمیرِ ست…
///
/// جدا از `Visit.caseCost` است: آن هزینهٔ مستقیمِ یک عمل است و در تسویهٔ همان
/// عمل کم می‌شود؛ این هزینهٔ عمومیِ شرکت است و بینِ شرکا تقسیم می‌شود.
model Expense {
  id       Int      @id @default(autoincrement())
  title    String
  category String?
  /// تومان
  amount   Int
  spentAt  DateTime @map("spent_at")

  /// از کدام حساب پرداخت شد.
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  bankAccountId Int?         @map("bank_account_id")
  /// ⚠️ کدام **شریک** از جیبِ خودش داد. اگر پر باشد، بقیهٔ شرکا به او بدهکار
  /// می‌شوند و دفترِ حسابِ جاری همین‌جا ساخته می‌شود.
  paidBy        Partner?     @relation(fields: [paidById], references: [id], onDelete: SetNull)
  paidById      Int?         @map("paid_by_id")

  notes       String?
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  transportRun TransportRun?

  @@index([spentAt])
  @@index([category])
  @@map("expenses")
}

/// دفترِ حسابِ جاریِ شرکا — «چه کسی به چه کسی چقدر بدهکار است».
///
/// ⚠️ این با `ShareEntry` فرق دارد و جایگزینش نیست: ShareEntry می‌گوید سهمِ هر
/// شریک از یک عمل **چقدر است**، این‌جا می‌گوید چون پول به حسابِ یکی رفت یا
/// هزینه را یکی داد، **چه کسی به چه کسی بدهکار شد**. در ملک‌طب همین جدول
/// (`partner_ledger`) وجود داشت و بدونش، شرکت با دو حسابِ شخصی قابلِ اداره نیست.
///
/// فقط‌افزودنی: تسویه با ردیفِ تازه انجام می‌شود، و ابطال با `voidedAt` —
/// همان الگوی `supersededAt` روی Settlement.
model PartnerLedger {
  id Int @id @default(autoincrement())

  /// profit_share | expense_paid | settlement
  entryType String @map("entry_type")

  fromPartnerId Int    @map("from_partner_id") // بدهکار
  fromName      String @map("from_name")
  toPartnerId   Int    @map("to_partner_id") // بستانکار
  toName        String @map("to_name")

  /// تومان، همیشه مثبت. جهت با from/to مشخص می‌شود نه با علامت.
  amount Int

  /// ارجاع‌های اختیاری — بدونِ FK، تا حذفِ مراجعه سابقهٔ مالی را نبرد.
  visitId      Int?    @map("visit_id")
  visitCode    String? @map("visit_code")
  expenseId    Int?    @map("expense_id")
  settlementId Int?    @map("settlement_id")

  description String?
  /// open | settled
  status      String    @default("open")
  settledAt   DateTime? @map("settled_at")
  voidedAt    DateTime? @map("voided_at")

  entryDate   DateTime @map("entry_date")
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([status, voidedAt])
  @@index([fromPartnerId, toPartnerId])
  @@index([settlementId])
  @@index([expenseId])
  @@map("partner_ledger")
}

/// پرداختِ سهم — جراح، کارشناس یا شریک پولش را گرفت.
///
/// ⚠️ به `ShareEntry` گره نمی‌خورد بلکه به (مراجعه، طرف): تسویه نسخه‌دار است و
/// با هر محاسبهٔ دوباره ردیف‌های سهم عوض می‌شوند، ولی «سهمِ جراحِ این عمل پرداخت
/// شده» واقعیتی است که با محاسبهٔ دوباره از بین نمی‌رود.
model Payout {
  id      Int   @id @default(autoincrement())
  visit   Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  visitId Int   @map("visit_id")

  /// surgeon | tech | partner
  party     String
  partyId   Int?   @map("party_id")
  partyName String @map("party_name")
  amount    Int // تومان

  paidAt        DateTime     @map("paid_at")
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  bankAccountId Int?         @map("bank_account_id")
  reference     String?
  notes         String?

  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  cheques Cheque[]

  @@index([visitId])
  @@index([party, partyId])
  @@index([paidAt])
  @@map("payouts")
}

/// چک — ابزارِ پرداختِ رایج در ایران، با سررسید و سرنوشتِ مستقل.
///
/// جدا از Payment/Payout است چون **زمانِ تعهد با زمانِ نقد‌شدن فرق دارد**: چکی
/// که امروز گرفته‌ایم ممکن است دو ماهِ دیگر پاس شود یا برگشت بخورد. ثبتش
/// به‌عنوانِ پرداختِ نقدی یعنی خزانه پولی را نشان می‌دهد که هنوز نیامده.
model Cheque {
  id       Int      @id @default(autoincrement())
  number   String
  bankName String?  @map("bank_name")
  amount   Int // تومان
  dueAt    DateTime @map("due_at")

  /// in = دریافتی (از بیمار/بیمارستان) · out = صادره (به جراح/تأمین‌کننده)
  direction String
  partyName String @map("party_name")

  /// pending | cashed | bounced | cancelled
  status   String    @default("pending")
  statusAt DateTime? @map("status_at")

  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  bankAccountId Int?         @map("bank_account_id")
  visitId       Int?         @map("visit_id")
  payout        Payout?      @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  payoutId      Int?         @map("payout_id")

  notes       String?
  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([status, dueAt])
  @@index([direction])
  @@map("cheques")
}

/// سالِ مالی — و مهم‌تر: **قفلِ دوره**.
///
/// وقتی سالی بسته می‌شود، هیچ سند مالی با تاریخِ داخلِ آن دوره ثبت یا حذف
/// نمی‌شود. بدونِ این، اصلاحِ یک هزینهٔ پارسال گزارشِ بسته‌شدهٔ پارسال را
/// بی‌سروصدا عوض می‌کند و هیچ‌کس نمی‌فهمد.
model FiscalYear {
  id       Int      @id @default(autoincrement())
  title    String   @unique // «۱۴۰۵»
  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  closedAt   DateTime? @map("closed_at")
  closedById Int?      @map("closed_by_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([startsAt, endsAt])
  @@map("fiscal_years")
}

/// نیروی حمل‌ونقل — راننده یا پیک. همان الگوی `Surgeon`: هویت در `Person`،
/// نقش این‌جا.
///
/// ⚠️ عمداً `Account` نیست. راننده به سامانه وارد نمی‌شود؛ گره‌زدنش به حسابِ
/// کاربری یعنی برای تعریفِ هر راننده باید یک لاگین ساخت و مسیرِ ثبت‌نامِ OTP
/// را طی کرد — و در عمل یعنی راننده هیچ‌وقت تعریف نمی‌شود. کارشناس برعکس،
/// حساب دارد چون به پنلِ کارشناسی وارد می‌شود.
model TransportStaff {
  id       Int    @id @default(autoincrement())
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId Int    @unique @map("person_id")

  /// driver | courier — نقشِ معمولِ این نفر؛ نقشِ هر مأموریت روی خودِ تخصیص است.
  role String
  /// خودرو و پلاک — در ابلاغ و هماهنگی با نگهبانیِ بیمارستان لازم می‌شود.
  vehicle String?
  active  Boolean @default(true)
  notes   String?

  runs TransportRun[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([role, active])
  @@map("transport_staff")
}

/// مسیرِ یک روزِ یک نیرو — «صبح پخش، عصر جمع».
///
/// ⚠️ **دانهٔ درست، «مسیر» است نه «عمل».** اول راننده به هر مراجعه جدا تخصیص
/// داده می‌شد؛ ولی راننده یک ست را به یک بیمارستان نمی‌برد — چند ست را به
/// ترتیب به چند بیمارستان می‌برد و عصر جمع می‌کند. با تخصیصِ per-visit،
/// «رانندهٔ امروز چه مسیری دارد» جواب نداشت و ابلاغ هم N پیامِ جدا می‌شد.
/// حالا «رانندهٔ این عمل» **مشتق** است: عمل ← حواله ← توقف ← مسیر ← نیرو.
model TransportRun {
  id      Int            @id @default(autoincrement())
  staff   TransportStaff @relation(fields: [staffId], references: [id], onDelete: Restrict)
  staffId Int            @map("staff_id")
  /// روزِ مسیر (بدونِ ساعت) — کلیدِ «مسیرهای امروز».
  runDate DateTime       @map("run_date")
  /// خودرو اگر با خودروی همیشگیِ نیرو فرق کند.
  vehicle String?
  /// planned | active | done
  status  String         @default("planned")
  notes   String?

  /// هزینهٔ همین مسیر — تومان. سه قلمِ جدا چون مدیر می‌پرسد «بنزین چقدر شد»
  /// نه فقط «حمل چقدر شد».
  fuelCost  Int?    @map("fuel_cost")
  driverFee Int?    @map("driver_fee")
  otherCost Int?    @map("other_cost")
  costNote  String? @map("cost_note")
  /// ⚠️ هزینه **دو جا ثبت نمی‌شود**: عددهای بالا فقط تفکیک‌اند و ردیفِ واقعیِ
  /// دفتر همین `Expense` است. اگر مسیر هزینهٔ مستقلِ خودش را نگه می‌داشت،
  /// گزارشِ مالی یا دوبار می‌شمرد یا اصلاً نمی‌دید.
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  expenseId Int?     @unique @map("expense_id")

  stops TransportStop[]

  createdById Int?     @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([runDate, staffId])
  @@map("transport_runs")
}

/// یک توقف در مسیر — تحویل یا جمع‌آوری، با ترتیبِ صریح.
model TransportStop {
  id     Int          @id @default(autoincrement())
  /// ⚠️ اختیاری: توقفِ جمع‌آوری که از اعلامِ پایانِ کارشناس ساخته می‌شود هنوز
  /// راننده ندارد. «بی‌مسیر» یعنی کاری که باید انجام شود ولی هنوز کسی
  /// برایش تعیین نشده — همان چیزی که مدیر باید ببیند، نه اینکه گم شود.
  run    TransportRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId  Int?          @map("run_id")
  /// ترتیبِ توقف در مسیر. عددِ صریح، نه ترتیبِ ساعت: گاهی دو توقف ساعت ندارند
  /// و ترتیبشان را چینش‌کننده تعیین می‌کند.
  seq    Int

  hospital     Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  hospitalId   Int?      @map("hospital_id")
  /// مقصدی که بیمارستان نیست (انبار، دفتر، آدرسِ آزاد).
  locationName String?   @map("location_name")

  /// deliver | pickup
  kind      String
  /// ساعتِ برنامه‌ریزی‌شده — «HH:MM»
  plannedAt String?   @map("planned_at")
  doneAt    DateTime? @map("done_at")
  /// نامِ تحویل‌گیرندهٔ **برنامه‌ریزی‌شده** — «بده به کارشناس».
  handedTo  String?   @map("handed_to")
  /// آن‌که **واقعاً** تحویل گرفت. راننده گاهی زودتر می‌رسد و بار را به
  /// داروخانه یا CSR می‌دهد؛ اگر همان فیلدِ برنامه بازنویسی شود، بعداً
  /// معلوم نیست برنامه چه بود و واقعیت چه شد.
  handedActual String? @map("handed_actual")
  notes     String?

  transfers StockTransfer[]
  proofs    StopProof[]

  @@unique([runId, seq])
  @@index([runId])
  @@map("transport_stops")
}

/// عکسِ رسیدِ تحویل — امضای CSR، برگهٔ مهرشده، یا خودِ ست روی میز.
///
/// ⚠️ عمداً `Document` نیست: مدرکِ بیمار به پروندهٔ بیمار می‌رود و راننده هیچ
/// زمینهٔ بیماری ندارد. رسیدِ تحویل سندِ **عملیاتی** است نه بالینی، و بیشترین
/// اختلاف با بیمارستان («ما تحویل نگرفتیم» / «ست ناقص بود») دقیقاً همین‌جاست.
model StopProof {
  id     Int           @id @default(autoincrement())
  stop   TransportStop @relation(fields: [stopId], references: [id], onDelete: Cascade)
  stopId Int           @map("stop_id")

  fileName String @map("file_name")
  mimeType String @map("mime_type")
  size     Int
  /// هم نامِ فایل روی دیسک است هم کلیدِ یکسانی.
  sha256   String
  caption  String?

  uploadedById Int?     @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([stopId])
  @@map("stop_proofs")
}

/// قلمِ داخلِ یک ست — «ستِ پدیکولار ۲۰ قلم دارد».
///
/// ⚠️ بدونِ این، ست یک واحدِ اتمی است و کسریِ برگشت دیده نمی‌شود: ستی که با
/// ۲۰ قلم رفت و با ۱۹ برگشت، در دفتر همان «۱ ست» است. بیشترین نشتیِ مالیِ
/// شرکتِ تجهیزات همین است.
model ItemComponent {
  id     Int  @id @default(autoincrement())
  set    Item @relation("SetContents", fields: [setId], references: [id], onDelete: Cascade)
  setId  Int  @map("set_id")
  /// قلم می‌تواند خودش کالای تعریف‌شده باشد یا فقط یک نام (پیچِ بی‌کد).
  part   Item? @relation("PartOfSets", fields: [partId], references: [id], onDelete: SetNull)
  partId Int?  @map("part_id")
  label  String
  quantity Int @default(1)
  notes  String?

  @@index([setId])
  @@map("item_components")
}

/// شمارشِ محتویاتِ ست هنگام برگشت — «چه چیزی کم آمد».
///
/// فقط کسری ثبت می‌شود، نه کلِ شمارش: ثبتِ ۲۰ ردیفِ «سالم» برای هر برگشت
/// یعنی هیچ‌کس این کار را نمی‌کند و کسری هم ثبت نمی‌شود.
model SetShortage {
  id         Int           @id @default(autoincrement())
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  transferId Int           @map("transfer_id")
  lot        StockLot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  lotId      Int           @map("lot_id")

  label    String
  missing  Int    @default(1)
  /// missing | damaged
  kind     String @default("missing")
  notes    String?

  reportedById Int?     @map("reported_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([transferId])
  @@map("set_shortages")
}

/// صورت‌برداریِ دوره‌ای از یک داراییِ امانی.
///
/// ⚠️ سه عدد دارد نه دو: **انتظار**، **شمرده‌شده**، و از کسریِ بینشان آن بخشی
/// که «مصرف شد» جدا می‌شود. تفاوتِ «مصرف» و «گم» تفاوتِ فاکتورِ فروش با زیانِ
/// شرکت است؛ اگر یک عددِ «مغایرت» بنویسیم، هر دو با هم دفن می‌شوند.
model ConsignmentCount {
  id         Int      @id @default(autoincrement())
  lot        StockLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  lotId      Int      @map("lot_id")
  hospital   Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  hospitalId Int?     @map("hospital_id")
  countedAt  DateTime @map("counted_at")
  notes      String?

  lines ConsignmentCountLine[]

  countedById Int?     @map("counted_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([lotId, countedAt])
  @@map("consignment_counts")
}

/// یک قلم از صورت‌برداری. `label` همان عنوانِ محتویاتِ ست است تا شمارش و
/// چک‌لیستِ برگشت از یک واژگان بخوانند.
model ConsignmentCountLine {
  id      Int              @id @default(autoincrement())
  count   ConsignmentCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  countId Int              @map("count_id")

  label    String
  expected Int @default(0)
  counted  Int @default(0)
  /// چند تا از کسری «مصرف شد» — یعنی قابلِ فاکتور. باقی‌اش گم/خراب است.
  used     Int @default(0)
  notes    String?

  @@index([countId])
  @@map("consignment_count_lines")
}


// ─────────────────────────────────────────────────────────────────────────────
// تعریفِ فرم — همان «چه چیزی پرسیده می‌شود» به‌شکلِ داده، نه کد
// ─────────────────────────────────────────────────────────────────────────────

/// یک فرم: مجموعه‌ای از فیلدها که در یک جای مشخص از برنامه پرسیده می‌شوند.
///
/// ⚠️ چرا اصلاً جدول شد و در کد نماند: تا دیروز «فرمِ ثبتِ مراجعه» یعنی JSXِ
/// دستی در `Dashboard.jsx` و «فرمِ ثبت‌نام» یعنی JSXِ دستی در `pages/Intake.jsx`.
/// نتیجه این بود که هر شرکت باید همان فرم را می‌پذیرفت — مطبی که می‌خواهد
/// «شکایتِ اصلی» بپرسد یا نورومانیتورینگی که «تعدادِ کانال» می‌خواهد، هیچ راهی
/// جز تغییرِ کدِ محصول نداشت.
///
/// ⚠️ **حوزهٔ کاری (`vertical`) فرم را قفل نمی‌کند، فقط شروعش می‌کند.** موقعِ
/// seed، مجموعهٔ فرم‌های همان حوزه ساخته می‌شود (مطب: ویزیت/جراحی/پیگیری —
/// نورومانیتورینگ: فقط عمل) ولی از آن لحظه به بعد سوپرادمین صاحبِ آن‌هاست.
/// اگر حوزه فرم را قفل می‌کرد، «ماژولِ ویرایشِ فرم» بی‌معنا بود.
model FormDef {
  id  Int    @id @default(autoincrement())
  /// کلیدِ پایدارِ ماشینی: `visit.clinic`, `visit.surgery`, `visit.followup`,
  /// `intake`, `survey`. کد با این کلید فرم را پیدا می‌کند، نه با عنوان —
  /// چون عنوان را کاربر عوض می‌کند و آن‌وقت هر ارجاعِ کدی می‌شکند.
  key String @unique

  /// آنچه کاربر می‌بیند. قابلِ تغییر، بی‌آنکه چیزی بشکند.
  title String

  /// کجا استفاده می‌شود — و مهم‌تر: **پرشدنش چه می‌سازد**.
  ///
  /// `visit`  → یک مراجعهٔ تازه با `Visit.kind = visitKind`.
  /// `record` → به پروندهٔ بیمار می‌چسبد و مراجعه نمی‌سازد (نظرسنجی، جوابِ
  ///            آزمایش، شرحِ حال). جانشینِ `survey`ِ قدیمی.
  /// `intake` → فرمِ ثبت‌نامِ اولیه که پرونده را باز می‌کند.
  ///
  /// ⚠️ `survey` به `record` مهاجرت کرد: «نظرسنجی» یک **مصداق** است نه یک
  /// محدوده. تا وقتی محدودهٔ خودش را داشت، هر نوعِ تازهٔ زیرپرونده (جوابِ
  /// آزمایش، شرحِ حال) یک محدودهٔ تازه و یک شاخهٔ تازه در کد می‌خواست.
  scope String

  /// فقط برای `scope=visit`: این فرم مالِ کدام نوعِ مراجعه است
  /// (`clinic` | `surgery` | `followup` | `consult`). همان مقادیرِ `Visit.kind`.
  visitKind String? @map("visit_kind")

  /// راهنمای بالای فرم — یک جمله برای پرکننده.
  hint String?

  /// رنگِ کارتِ این فرم در داشبورد — **توکن** (`violet`, `teal`, …) نه هگز.
  ///
  /// ⚠️ توکن و نه `#rrggbb`: رنگِ برندِ هر نصب و تمِ روشن/تاریک فرق می‌کنند، و
  /// هگزی که امروز روی تمِ تاریک خواناست فردا روی نصبِ دیگری ناخوانا می‌شود.
  /// `null` یعنی «خودکار»: رنگ از hashِ کلید مشتق می‌شود، پس ساختنِ فرمِ تازه
  /// رنگِ کارت‌های قبلی را جابه‌جا نمی‌کند.
  color String?

  active Boolean @default(true)

  /// نقشِ این فرم در **پیگیریِ پس از عمل** (فقط scope=record):
  /// `general` → بخشِ عمومیِ فرمِ پیگیری، برای همهٔ عمل‌ها.
  /// `procedure` → بخشِ اختصاصیِ نوعِ عملِ `procedureTypeId`.
  /// `diagnosis` → بخشِ اختصاصیِ تشخیصِ `diagnosisId`.
  /// null → این فرم ربطی به پیگیری ندارد.
  /// هنگامِ ارسال، بخشِ عمومی + بخش‌های اختصاصیِ منطبق **یک لینک** می‌شوند
  /// (فیلدهای اختصاصی صفحه‌های بعدیِ همان فرم‌اند).
  followUp        String?        @map("follow_up")
  procedureType   ProcedureType? @relation(fields: [procedureTypeId], references: [id], onDelete: SetNull)
  procedureTypeId Int?           @map("procedure_type_id")
  diagnosis       Diagnosis?     @relation(fields: [diagnosisId], references: [id], onDelete: SetNull)
  diagnosisId     Int?           @map("diagnosis_id")

  fields FormField[]

  /// لینک‌هایی که این فرم را می‌فرستند — منبعِ «آیا این فرم استفاده می‌شود؟»
  /// در `removeForm`. بدونِ این، حذفِ فرم لینک را بی‌صدا از کار می‌انداخت.
  intakeLinks       IntakeLink[]
  intakeSubmissions IntakeSubmission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([scope, active])
  @@map("form_defs")
}

/// یک پرسشِ فرم.
///
/// ⚠️ **فیلدهای هسته‌ای هم این‌جا ردیف دارند** (`builtin = true`) — نه فقط
/// فیلدهای دلخواه. دلیلش خواستهٔ صریحِ «سوپرادمین بتواند هر فیلد را ستاره‌دار
/// کند یا نکند» است: اگر اجباری‌بودنِ «جراح» در کد بماند و اجباری‌بودنِ فیلدِ
/// دلخواه در دیتابیس، دو منبعِ حقیقت داریم و کاربر نمی‌فهمد چرا بعضی ستاره‌ها
/// قابلِ تغییرند و بعضی نه.
///
/// تفاوتِ builtin با فیلدِ دلخواه فقط سه چیز است: حذف نمی‌شود، `key`اش عوض
/// نمی‌شود، و مقدارش به **ستونِ واقعیِ** `Visit`/`Patient` می‌نشیند نه به JSON.
model FormField {
  id     Int     @id @default(autoincrement())
  form   FormDef @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId Int     @map("form_id")

  /// کلیدِ ماشینی. برای builtin همان نامِ ستون (`surgeonId`, `opDate`, …).
  key String

  label String

  /// بخشِ نقش — «این فیلد مالِ کیست». doctor | secretary | nurse | assistant.
  /// `null` = عمومی، همه می‌نویسند. اجرای واقعی سمتِ سرور است
  /// (`assertRoleOwnership`)؛ رنگ و قفلِ کلاینت فقط نمایشِ همان است.
  role String?
  roles String[] @default([])

  /// `text | textarea | number | money | select | multiselect | date | time |
  ///  bool | phone | rating | image | payment`
  ///
  /// ⚠️ عمداً محدود و کم: هر نوعِ تازه یعنی یک شاخهٔ تازه در رندرِ کلاینت **و**
  /// یک قاعدهٔ تازه در اعتبارسنجیِ سرور. نوعی که فقط یک‌جا پیاده شود، فرمی
  /// می‌سازد که در مرورگر درست به‌نظر می‌رسد و روی سرور بی‌صدا رد می‌شود.
  ///
  /// ⚠️ `payment` **مقداری در `data` نمی‌نشیند**: شماره‌های حساب هنگامِ رندر از
  /// `IntakeLink.bankAccountId` خوانده می‌شوند (و اگر خالی بود، از فهرستِ
  /// سراسریِ `showOnIntake`). پس اعتبارسنجیِ «اجباری» رویش اعمال نمی‌شود —
  /// وگرنه فرمی می‌ساختیم که هیچ‌وقت ذخیره نمی‌شود.
  /// `image` برعکس، یک **ارجاع** (`{id,url,name}`) ذخیره می‌کند و ستاره‌اش
  /// معنی دارد.
  type String @default("text")

  /// همان «ستاره». تک‌منبعِ اجباری‌بودن: هم ستارهٔ کنارِ برچسب و هم ۴۰۰ِ سرور
  /// از همین یک ستون می‌آیند، تا فرم و سرور هیچ‌وقت دو نظر نداشته باشند.
  required Boolean @default(false)

  /// گزینه‌های `select`/`multiselect` — آرایهٔ `{ v, l }`.
  options Json @default("[]")

  hint        String?
  placeholder String?

  /// ترتیبِ نمایش. عدد و نه رشته، تا جابه‌جایی با یک UPDATE انجام شود.
  sort Int @default(0)

  /// صفحهٔ چندم — چینشِ چندصفحه‌ایِ فرم.
  ///
  /// ⚠️ پیش‌فرض `1` و نه nullable: فرمِ تک‌صفحه‌ای همان صفحهٔ ۱ است، و nullable
  /// یعنی هر مرتب‌سازی باید `null` را هم تفسیر کند. مرتب‌سازیِ واقعی
  /// `(page, sort, id)` است — `sort` داخلِ صفحه معنی دارد نه در کلِ فرم.
  ///
  /// ⚠️ داشبورد همهٔ صفحه‌ها را پشتِ‌هم نشان می‌دهد و فقط فرمِ عمومی
  /// صفحه‌به‌صفحه می‌رود: ادمین یک‌صفحه‌ای کار می‌کند و «بعدی» زدن برایش
  /// کندکردنِ کار است، ولی بیمار روی موبایل فرمِ بلند را رها می‌کند.
  page Int @default(1)

  /// فیلدِ هسته‌ای — حذف‌نشدنی، کلید ثابت، مقدارش به ستونِ واقعی می‌رود.
  builtin Boolean @default(false)

  /// خاموش‌کردنِ فیلد بدونِ حذفش. برای builtin تنها راهِ «نمی‌خواهمش» است.
  active Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([formId, key])
  @@index([formId, page, sort])
  @@map("form_fields")
}


/// کانالِ آشناییِ بیمار — کاتالوگِ قابلِ ویرایشِ کاربر، مثلِ بقیهٔ تعاریفِ پایه.
///
/// ⚠️ فهرستِ ثابت در کد نوشته نشد چون هر شرکت کانال‌های خودش را دارد: یکی
/// اینستاگرام دارد و دیگری «تابلوی مطب» و سومی «بیمهٔ فلان». فهرستِ ما هر
/// کدامشان را جا بیندازد، کاربر مجبور می‌شود «سایر» بزند — و همان‌جا گزارش
/// بی‌معنی می‌شود.
model ReferralSource {
  id      Int     @id @default(autoincrement())
  name    String  @unique
  /// آیا نامِ معرف پرسیده شود؟ برای «معرفیِ پزشک» بله، برای «اینستاگرام» نه.
  asksWho Boolean @default(false) @map("asks_who")
  active  Boolean @default(true)
  sort    Int     @default(0)

  patients  Patient[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("referral_sources")
}

/// دعوت‌نامهٔ نظرسنجی — یک لینکِ یکتا برای یک بیمار، پس از یک مراجعه.
///
/// ⚠️ چرا جدولِ جدا و نه یک فیلد روی مراجعه: نظرسنجی ممکن است فرستاده شود و
/// بی‌جواب بماند، دوباره فرستاده شود، یا اصلاً برای مراجعه‌ای نباشد. هر سه
/// حالت روی یک ستونِ ساده نمی‌نشیند و «فرستادیم ولی جواب نداد» — که خودش
/// عددِ مهمی است — گم می‌شد.
model SurveyInvite {
  id    Int    @id @default(autoincrement())
  token String @unique

  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId Int     @map("patient_id")
  /// مراجعه‌ای که نظرسنجی دربارهٔ آن است. اختیاری: ممکن است نظرسنجیِ کلی باشد.
  visit     Visit?  @relation(fields: [visitId], references: [id], onDelete: SetNull)
  visitId   Int?    @map("visit_id")

  /// pending | answered | expired
  status String @default("pending")

  /// پاسخ‌ها — کلیدِ فیلد به مقدار، همان قرارِ `Visit.extra`.
  answers Json @default("{}")

  /// ⚠️ امتیازِ کلی **جدا** از JSON هم ذخیره می‌شود، چون گزارشِ رضایت رویش
  /// میانگین می‌گیرد و میانگین‌گرفتن از JSON یعنی خواندنِ کلِ جدول در حافظه.
  overall Int?

  sentAt     DateTime  @default(now()) @map("sent_at")
  answeredAt DateTime? @map("answered_at")
  expiresAt  DateTime  @map("expires_at")

  @@index([status, sentAt])
  @@index([patientId])
  @@map("survey_invites")
}

// ═══════════════════ نوبت‌دهی — `docs/BOOKING.md` مرحلهٔ ۲ ═══════════════════

/// **برنامهٔ کاری** — «چه کسی، چه روزی، چه ساعتی، چه موضوعی».
///
/// دو حالت دارد و هر مطب یکی را می‌گیرد:
///  • `slot`     — بازه به نوبت‌های `slotMinutes` دقیقه‌ای تقسیم می‌شود و بیمار
///                 **ساعتِ دقیق** می‌گیرد (شنبه ۱۶–۲۰، هر نوبت ۱۵ دقیقه).
///  • `capacity` — در همان بازه فقط `capacity` نفر پذیرفته می‌شوند و بیمار
///                 **روز** می‌گیرد نه ساعت. برای مطبی که ساعتِ دقیق نمی‌دهد.
///
/// ⚠️ هر دو حالت در **یک** جدول‌اند نه دو جدول: تفاوتشان فقط در «واحدِ ظرفیت»
/// است و همهٔ چیزهای دیگر — روز، بازه، پزشک، موضوع، بازهٔ اعتبار — یکی است.
/// دو جدول یعنی هر قاعدهٔ تازه (تعطیلی، موضوع، اعتبار) دوبار نوشته شود و
/// روزی یکی‌شان جا بیفتد.
model AvailabilityRule {
  id Int @id @default(autoincrement())

  /// پزشکِ این برنامه. خالی = کلِ مطب (نصبی که یک پزشک دارد چیزی انتخاب نمی‌کند).
  doctor   Account? @relation("AvailabilityDoctor", fields: [doctorId], references: [id], onDelete: Cascade)
  doctorId Int?     @map("doctor_id")

  /// روزِ هفتهٔ **شمسی**: شنبه = ۰ … جمعه = ۶ (قانون ۱۴).
  weekday Int

  /// دقیقه از نیمه‌شب — ۱۷:۰۰ می‌شود 1020. عدد و نه رشته، تا مقایسه و
  /// تقسیم‌بندی حساب باشد نه تجزیهٔ متن.
  startMin Int @map("start_min")
  endMin   Int @map("end_min")

  /// `slot` | `capacity`
  mode String @default("slot")

  /// فقط در `slot` — طولِ هر نوبت به دقیقه.
  slotMinutes Int? @map("slot_minutes")

  /// فقط در `capacity` — تعدادِ نفراتِ پذیرفته‌شده در کلِ بازه.
  capacity Int?

  /// موضوع‌های مجازِ این روز — «شنبه‌ها ویزیتِ اولیه». خالی = همهٔ موضوع‌ها.
  topics AvailabilityRuleTopic[]

  /// بازهٔ اعتبارِ خودِ قاعده — برنامهٔ تابستان با برنامهٔ زمستان فرق می‌کند.
  activeFrom DateTime  @default(now()) @map("active_from")
  activeTo   DateTime? @map("active_to")

  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([weekday, active])
  @@map("availability_rules")
}

/// موضوع‌های مجازِ یک قاعده — رابطهٔ چندبه‌چند با جدولِ صریح، تا بعداً بشود
/// روی خودِ رابطه چیزی نشاند (مثلاً ظرفیتِ جدا برای هر موضوع).
model AvailabilityRuleTopic {
  rule    AvailabilityRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId  Int              @map("rule_id")
  topic   VisitTopic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicId Int              @map("topic_id")

  @@id([ruleId, topicId])
  @@map("availability_rule_topics")
}

/// **استثنای تقویم** — یک روزِ خاص که تعطیل است یا برنامهٔ ویژه دارد.
///
/// ⚠️ بدونِ این، «پنجشنبهٔ این هفته تعطیل است» فقط با خاموش‌کردنِ کلِ قاعدهٔ
/// پنجشنبه ممکن بود — یعنی همهٔ پنجشنبه‌های آینده هم می‌رفتند.
model AvailabilityException {
  id   Int      @id @default(autoincrement())
  date DateTime @db.Date

  doctor   Account? @relation("AvailabilityExceptionDoctor", fields: [doctorId], references: [id], onDelete: Cascade)
  doctorId Int?     @map("doctor_id")

  /// `true` = این روز تعطیل است. `false` = روزِ اضافه با بازه/ظرفیتِ زیر.
  closed Boolean @default(true)

  startMin    Int? @map("start_min")
  endMin      Int? @map("end_min")
  mode        String?
  slotMinutes Int? @map("slot_minutes")
  capacity    Int?

  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([date])
  @@map("availability_exceptions")
}

/// **نوبت** — خودِ رزرو.
///
/// ⚠️ عمداً جدا از `Visit`: نوبت پیش از مراجعه وجود دارد و ممکن است هرگز به
/// مراجعه نرسد (کنسل، عدم‌مراجعه). ریختنِ هر دو در یک جدول یعنی فهرستِ
/// مراجعات پر شود از رکوردهایی که هیچ‌وقت مراجعه نشدند و هر گزارشِ مالی —
/// درآمد، سهم، بدهی — رویشان حساب کند.
model Appointment {
  id Int @id @default(autoincrement())

  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientId Int?     @map("patient_id")

  doctor   Account? @relation("AppointmentDoctor", fields: [doctorId], references: [id], onDelete: SetNull)
  doctorId Int?     @map("doctor_id")

  topic   VisitTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  topicId Int?        @map("topic_id")

  date DateTime @db.Date

  /// فقط در حالتِ `slot` — دقیقه از نیمه‌شب.
  startMin Int? @map("start_min")

  /// فقط در حالتِ `capacity` — شمارهٔ صف در آن روز.
  seq Int?

  /// held | confirmed | cancelled | done | noshow
  ///
  /// ⚠️ `held` جداست تا وضعیتِ **نوبت** از وضعیتِ **پرداخت** مستقل بماند:
  /// افزودنِ درگاهِ آنلاین باید فقط یک منبعِ تأیید اضافه کند، نه ماشینِ
  /// وضعیت را بازنویسی.
  status String @default("held")

  /// ثبت‌نامی که این نوبت را گرفت (مرحلهٔ ۳).
  submissionId Int? @unique @map("submission_id")

  /// مراجعه‌ای که از این نوبت ساخته شد.
  visit   Visit? @relation(fields: [visitId], references: [id], onDelete: SetNull)
  visitId Int?   @unique @map("visit_id")

  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// ⚠️ همین قید است که جلوی «دو بیمار، یک اسلات» را می‌گیرد. بدونِ آن،
  /// «اول بخوان بعد بنویس» دو درخواستِ همزمان را هر دو موفق می‌کند.
  @@unique([doctorId, date, startMin])
  @@index([date, status])
  @@map("appointments")
}

/// یادآوریِ برنامه‌ریزی‌شده — دفترِ ارسال، نه صف: هر ردیف یک پیامکِ قرار است
/// که یا هنوز موعدش نرسیده (pending)، یا رفته (sent)، یا نرفت (failed)، یا
/// موضوعش منتفی شد (cancelled — تاریخِ ویزیت عوض/پاک شد).
///
/// ⚠️ متن و شماره **همین‌جا کپی می‌شوند** نه لحظهٔ ارسال: یادآوری سندِ
/// «قرار بود چه بگوییم» است؛ اگر شمارهٔ بیمار فردا عوض شود، یادآوریِ
/// برنامه‌ریزی‌شده با شمارهٔ روزِ برنامه‌ریزی می‌ماند و sweep بعدی با
/// شمارهٔ تازه ساخته می‌شود (syncNextVisitReminder).
model Reminder {
  id Int @id @default(autoincrement())
  channel String @default("sms")
  dedupeKey String? @unique @map("dedupe_key")
  recipientAccountId Int? @map("recipient_account_id")
  recipientName String? @map("recipient_name")
  chatMessageId Int? @map("chat_message_id")
  providerId String? @map("provider_id")
  deliveryStatus String @default("unknown") @map("delivery_status")
  attemptedAt DateTime? @map("attempted_at")

  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId Int?     @map("patient_id")

  visit   Visit? @relation(fields: [visitId], references: [id], onDelete: Cascade)
  visitId Int?   @map("visit_id")

  /// نوبتی که این یادآوری مالِ آن است — برای هم‌گام‌سازیِ لغو/جابه‌جایی.
  appointmentId Int? @map("appointment_id")

  /// next_visit | surgery | pre_op_care | post_op_care | appointment | notice
  kind String

  /// موعدِ ارسال — UTC. sweep هر چند دقیقه pendingهای سررسیده را می‌فرستد.
  dueAt DateTime @map("due_at")

  phone String?
  text  String

  /// pending | sent | failed | cancelled
  status String  @default("pending")
  sentAt DateTime? @map("sent_at")
  error  String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([status, dueAt])
  @@index([visitId, kind])
  @@map("reminders")
}

model HospitalDuty {
  id Int @id @default(autoincrement())
  date DateTime @db.Date
  hospitalId Int @map("hospital_id")
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  techId Int @map("tech_id")
  tech Account @relation(fields: [techId], references: [id], onDelete: Restrict)
  arriveTime String @map("arrive_time")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@unique([date, hospitalId, techId])
  @@index([techId, date])
  @@map("hospital_duties")
}

/// اصلاح‌های دستیِ کاربر روی پیش‌نویس‌های دستیار — «یادگیری» یعنی retrieval:
/// چند نمونهٔ اخیرِ (پیش‌نویس ← نهایی) به promptهای بعدی برمی‌گردد تا سلیقهٔ
/// همین کلینیک رعایت شود. نه fine-tune، نه ارسالِ داده به جایی برای آموزش.
model AiFeedback {
  id    Int    @id @default(autoincrement())
  /// نوعِ شرح (history|visit|op|…) یا 'care' برای متنِ مراقبت
  kind  String
  draft String
  final String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([kind, createdAt])
  @@map("ai_feedback")
}

/// ── سفارش‌های بالینیِ زیرِ ویزیت ──────────────────────────────────────
/// چهار موجودیتِ جدا چون فیلدهایشان واقعاً فرق دارد (تیک‌های آزمایش در
/// برابرِ مودالیتهٔ تصویربرداری در برابرِ تخصصِ مشاور)؛ ولی چرخه‌شان یکی
/// است: ثبت → لینک برای بیمار → پاسخ → نشستن زیرِ همان ویزیت.
model LabOrder {
  id        Int      @id @default(autoincrement())
  patientId Int      @map("patient_id")
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  /// حذفِ مراجعه سفارش را نمی‌برد — سندِ پرونده است (SetNull).
  visitId   Int?     @map("visit_id")
  visit     Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  tests     String[] @default([])
  note      String?
  dueDate   DateTime? @map("due_date")
  token     String   @unique
  /// draft | sent | answered
  status    String   @default("draft")
  sentAt    DateTime? @map("sent_at")
  resultText String?  @map("result_text")
  resultLink String?  @map("result_link")
  resultUser String?  @map("result_user")
  resultPass String?  @map("result_pass")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([patientId])
  @@index([visitId])
  @@map("lab_orders")
}

