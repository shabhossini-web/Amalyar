  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitId   Int?     @map("visit_id")
  visit     Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  modalities String[] @default([])
  region    String?
  note      String?
  dueDate   DateTime? @map("due_date")
  token     String   @unique
  status    String   @default("draft")
  sentAt    DateTime? @map("sent_at")
  resultText String?  @map("result_text")
  resultLink String?  @map("result_link")
  resultUser String?  @map("result_user")
  resultPass String?  @map("result_pass")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([patientId])
  @@index([visitId])
  @@map("imaging_orders")
}

model ConsultOrder {
