// بک‌اندِ عمل‌یار — schema (استاندارد؛ auth + پروفایل + سطوح ۱–۶ + OTP)
generator client {
  provider      = "prisma-client-js"
  // native = محیط توسعه؛ linux-musl-openssl-3.0.x = ایمیج Alpine در سرور
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// همهٔ کاربران — پروفایلِ استاندارد + سطحِ دسترسیِ ۱..۶
/// سطوح: 1=بازدید 2=کارشناس 3=کارشناس‌ادمین 4=سوپروایزر 5=ادمین 6=سوپرادمین
model Account {
  id           Int       @id @default(autoincrement())
  firstName    String?   @map("first_name")
  lastName     String?   @map("last_name")
  username     String?   @unique
  phone        String?   @unique
  passwordHash String    @map("password_hash")
  selfie       String?   // dataURL سلفی (فعلاً؛ بعداً object-storage)
  level        Int       @default(1) // 1..6
  status       String    @default("pending") // pending | active | disabled | rejected
  approvedById Int?      @map("approved_by_id")
  approvedAt   DateTime? @map("approved_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  sessions    Session[]
  credentials WebauthnCredential[]

  @@map("accounts")
}

/// پس‌کی/اثر انگشت (WebAuthn) — هر کاربر می‌تواند چند دستگاه ثبت کند
model WebauthnCredential {
  id         Int      @id @default(autoincrement())
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId  Int      @map("account_id")
  credId     String   @unique @map("cred_id") // base64url
  publicKey  String   @map("public_key") // base64
  counter    Int      @default(0)
  transports String?
  name       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([accountId])
  @@map("webauthn_credentials")
}

/// سشن‌های چندتایی (حداکثر ۱۰ همزمان) — معادلِ account_sessions
model Session {
  id        String    @id @default(uuid())
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId Int       @map("account_id")
  tokenHash String    @map("token_hash")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([accountId])
  @@map("account_sessions")
}

/// دسترسیِ ماژول‌ها — قابلِ‌تنظیم توسط سوپرادمین (پیش‌فرض‌ها از کد seed می‌شوند).
/// enabled بعداً اهرمِ لایسنس/پلنِ SaaS هم می‌شود.
model Feature {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  minLevel  Int      @default(6) @map("min_level") // حداقل سطحِ لازم (۱..۶)
  enabled   Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("features")
}

/// بیمارِ دائمی — یک نفر، چند مراجعه. کدِ خوانا: AM-NNNN
model Patient {
  id         Int      @id @default(autoincrement())
  code       String   @unique // AM-0001
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  phone      String?
  nationalId String?  @map("national_id")
  createdAt  DateTime @default(now()) @map("created_at")

  visits Visit[]

  @@index([phone])
  @@map("patients")
}

/// مراجعه (Visit) — واحدِ اصلیِ کار: عمل/خدمت برای یک بیمار
/// ⚠️ همهٔ مبالغ «تومان» و عددِ صحیح‌اند (قانونِ تک‌واحدی — درسِ ملک‌طب)
model Visit {
  id           Int       @id @default(autoincrement())
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId    Int       @map("patient_id")
  seq          Int       @default(1) // شمارهٔ مراجعهٔ بیمار → کدِ AM-0001-V2
  surgeonName  String?   @map("surgeon_name") // فاز بعد: موجودیتِ جراح
  hospitalName String?   @map("hospital_name") // فاز بعد: موجودیتِ بیمارستان
  opDate       DateTime? @map("op_date") // تاریخِ عمل
  opStatus     String    @default("pending") @map("op_status") // pending | done | cancelled
  amount       Int       @default(0) // تومان
  paid         Int       @default(0) // تومان
  notes        String?
  createdById  Int?      @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([patientId])
  @@index([opStatus])
  @@index([opDate])
  @@map("visits")
}

/// کدهای یکبارمصرفِ ثبت‌نام/تأیید موبایل
model OtpCode {
  id         Int       @id @default(autoincrement())
  phone      String
  codeHash   String    @map("code_hash")
  purpose    String    @default("signup") // signup | ...
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone])
  @@map("otp_codes")
}
